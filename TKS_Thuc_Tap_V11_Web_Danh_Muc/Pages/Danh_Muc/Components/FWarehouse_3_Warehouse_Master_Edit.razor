@inherits FBase_Edit
@using TKS_Thuc_Tap_V11_Data_Access.Entity.DM

<div class="modal fade show" tabindex="-1" role="dialog" aria-hidden="true" style="display: block; padding-left: 0px; background-color: rgba(10, 10, 10, .8);">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title">@Get_Language_Data_Field(Is_Edit_Mode ? "Hiệu chỉnh" : "Thêm mới")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label='@Get_Language_Data_Field("Đóng")' @onclick="Cancel_Async"></button>
            </div>
            <div class="modal-body">
                <FWarehouse_3_Warehouse_Edit m_strEditor_Type="Master" m_strMaster_Type="@m_strMaster_Type" m_objKho="@m_objKho" m_objDon_Vi_Tinh="@m_objDon_Vi_Tinh" m_objLoai_San_Pham="@m_objLoai_San_Pham" m_objSan_Pham="@m_objSan_Pham" m_objNCC="@m_objNCC" m_objPermission="@m_objPermission" m_arrUnit="@m_arrUnit" m_arrCategory="@m_arrCategory" m_arrWarehouse="@m_arrWarehouse" m_arrWarehouseUser="@m_arrWarehouseUser" m_arrUser="@m_arrUser" OnAdd_Kho="OnAdd_Kho" OnUpdate_Kho="OnUpdate_Kho" OnAdd_Don_Vi_Tinh="OnAdd_Don_Vi_Tinh" OnUpdate_Don_Vi_Tinh="OnUpdate_Don_Vi_Tinh" OnAdd_Loai_San_Pham="OnAdd_Loai_San_Pham" OnUpdate_Loai_San_Pham="OnUpdate_Loai_San_Pham" OnAdd_San_Pham="OnAdd_San_Pham" OnUpdate_San_Pham="OnUpdate_San_Pham" OnAdd_NCC="OnAdd_NCC" OnUpdate_NCC="OnUpdate_NCC" OnSave_Permission="OnSave_Permission" OnCancel="Cancel_Async" />
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string m_strMaster_Type { get; set; } = "";
    [Parameter] public CDM_Kho m_objKho { get; set; } = new();
    [Parameter] public CDM_Don_Vi_Tinh m_objDon_Vi_Tinh { get; set; } = new();
    [Parameter] public CDM_Loai_San_Pham m_objLoai_San_Pham { get; set; } = new();
    [Parameter] public CDM_San_Pham m_objSan_Pham { get; set; } = new();
    [Parameter] public CDM_NCC m_objNCC { get; set; } = new();
    [Parameter] public CWarehousePermission m_objPermission { get; set; } = new();
    [Parameter] public List<CWarehouseLookup> m_arrUnit { get; set; } = new();
    [Parameter] public List<CWarehouseLookup> m_arrCategory { get; set; } = new();
    [Parameter] public List<CWarehouseLookup> m_arrWarehouse { get; set; } = new();
    [Parameter] public List<CWarehousePermission> m_arrWarehouseUser { get; set; } = new();
    [Parameter] public List<CWarehouseLookup> m_arrUser { get; set; } = new();
    [Parameter] public EventCallback<CDM_Kho> OnAdd_Kho { get; set; }
    [Parameter] public EventCallback<CDM_Kho> OnUpdate_Kho { get; set; }
    [Parameter] public EventCallback<CDM_Don_Vi_Tinh> OnAdd_Don_Vi_Tinh { get; set; }
    [Parameter] public EventCallback<CDM_Don_Vi_Tinh> OnUpdate_Don_Vi_Tinh { get; set; }
    [Parameter] public EventCallback<CDM_Loai_San_Pham> OnAdd_Loai_San_Pham { get; set; }
    [Parameter] public EventCallback<CDM_Loai_San_Pham> OnUpdate_Loai_San_Pham { get; set; }
    [Parameter] public EventCallback<CDM_San_Pham> OnAdd_San_Pham { get; set; }
    [Parameter] public EventCallback<CDM_San_Pham> OnUpdate_San_Pham { get; set; }
    [Parameter] public EventCallback<CDM_NCC> OnAdd_NCC { get; set; }
    [Parameter] public EventCallback<CDM_NCC> OnUpdate_NCC { get; set; }
    [Parameter] public EventCallback<CWarehousePermission> OnSave_Permission { get; set; }
    private bool Is_Edit_Mode => m_strMaster_Type switch
    {
        "Kho" => m_objKho.Auto_ID != 0,
        "DonViTinh" => m_objDon_Vi_Tinh.Auto_ID != 0,
        "LoaiSanPham" => m_objLoai_San_Pham.Auto_ID != 0,
        "SanPham" => m_objSan_Pham.Auto_ID != 0,
        "NCC" => m_objNCC.Auto_ID != 0,
        "KhoUser" => m_objPermission.Permission_ID != 0,
        _ => false
    };

    private Task Cancel_Async()
    {
        return OnClose.InvokeAsync(new CEvent_Call_Back { Message_ID = (int)EModal_Result.Close_Cancel });
    }
}
