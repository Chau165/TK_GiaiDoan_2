@inherits FBase

<div class="modal fade show" tabindex="-1" role="dialog" aria-hidden="true" style="display: block; background-color: rgba(10, 10, 10, .8);">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <ul class="nav nav-pills card-header-pills" role="tablist">
                    <li class="nav-item" role="presentation">
                        <a class="nav-link active" data-bs-toggle="tab" href="#product_info" role="tab" aria-selected="true">@Get_Language_Data_Field("Thông tin")</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" data-bs-toggle="tab" href="#product_history" role="tab" aria-selected="false" tabindex="-1">@Get_Language_Data_Field("Lịch sử xử lý")</a>
                    </li>
                </ul>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label='@Get_Language_Data_Field("Đóng")' @onclick="@(() => Modal_Cancel())"></button>
            </div>
            @((MarkupString)r_strError)
            <div class="modal-body">
                <div class="tab-content">
                    <div class="tab-pane active show" id="product_info" role="tabpanel">
                        <div class="row g-3">
                    <div class="col-lg-4">
                        <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("ID")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Auto_ID, true)</span></div>
                        <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Mã sản phẩm")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Ma_San_Pham, false)</span></div>
                        <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Tên sản phẩm")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Ten_San_Pham, false)</span></div>
                        <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Loại sản phẩm")</label><br /><span class="form-label">@CUtility.Get_Label_Text(Category_Display, false)</span></div>
                        <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Đơn vị tính")</label><br /><span class="form-label">@CUtility.Get_Label_Text(Unit_Display, false)</span></div>
                        <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Ghi chú")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Ghi_Chu, false)</span></div>
                    </div>
                    <div class="col-lg-4">
                        <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Ngày giờ tạo")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Created, false)</span></div>
                        <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Người tạo")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Created_By, false)</span></div>
                        <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Chức năng tạo")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Created_By_Function, false)</span></div>
                    </div>
                    <div class="col-lg-4">
                        <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Ngày cập nhật sau cùng")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Last_Updated, false)</span></div>
                        <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Người cập nhật sau cùng")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Last_Updated_By, false)</span></div>
                        <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Chức năng cập nhật sau cùng")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Last_Updated_By_Function, false)</span></div>
                    </div>
                        </div>
                    </div>
                    <div class="tab-pane" id="product_history" role="tabpanel">
                        <FCommon_Record_Action_History_List v_arrData="@m_arrRAH" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private CDM_San_Pham m_objData = new();
    private CDM_Loai_San_Pham? m_objCategory;
    private CDM_Don_Vi_Tinh? m_objUnit;
    private List<CLog_Record_Action_History> m_arrRAH = new();

    private string Category_Display => m_objCategory?.Ten_LSP
        ?? string.Format(Get_Language_Data_Field("Không tìm thấy loại sản phẩm (ID {0})"), m_objData.Loai_San_Pham_ID);
    private string Unit_Display => m_objUnit?.Ten_Don_Vi_Tinh
        ?? string.Format(Get_Language_Data_Field("Không tìm thấy đơn vị tính (ID {0})"), m_objData.Don_Vi_Tinh_ID);

    protected override void Load_Data()
    {
        m_objData = new CDM_San_Pham_Controller()
            .F2018_sp_sel_Get_By_ID(r_iAuto_ID)
            ?? throw new InvalidOperationException(Get_Language_Data_Field("Không tìm thấy sản phẩm cần xem."));

        m_objCategory = new CDM_Loai_San_Pham_Controller()
            .F2017_sp_sel_List_Loai_San_Pham_Lookup()
            .FirstOrDefault(v_objItem => v_objItem.Auto_ID == m_objData.Loai_San_Pham_ID);
        m_objUnit = new CDM_Don_Vi_Tinh_Controller()
            .F2016_sp_sel_List_Don_Vi_Tinh_Lookup()
            .FirstOrDefault(v_objItem => v_objItem.Auto_ID == m_objData.Don_Vi_Tinh_ID);

        m_arrRAH = new CLog_Record_Action_History_Controller()
            .FCommon_Sys_sp_sel_List_Log_Record_Action_History(r_iAuto_ID);
    }
}
