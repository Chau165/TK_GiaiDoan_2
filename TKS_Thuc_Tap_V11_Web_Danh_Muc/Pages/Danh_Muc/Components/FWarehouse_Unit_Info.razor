@inherits FBase

<div class="modal fade show" tabindex="-1" role="dialog" aria-hidden="true" style="display: block; background-color: rgba(10, 10, 10, .8);">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <ul class="nav nav-pills card-header-pills" role="tablist">
                    <li class="nav-item" role="presentation">
                        <a class="nav-link active" data-bs-toggle="tab" href="#warehouse_unit_info" role="tab" aria-selected="true">@Get_Language_Data_Field("Thông tin")</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" data-bs-toggle="tab" href="#warehouse_unit_history" role="tab" aria-selected="false" tabindex="-1">@Get_Language_Data_Field("Lịch sử xử lý")</a>
                    </li>
                </ul>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label='@Get_Language_Data_Field("Đóng")' @onclick="@(() => Modal_Cancel())"></button>
            </div>

            @((MarkupString)r_strError)

            <div class="modal-body">
                <div class="tab-content">
                    <div class="tab-pane active show" id="warehouse_unit_info" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-lg-4">
                                <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("ID")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Auto_ID, true)</span></div>
                                <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Tên đơn vị tính")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Ten_Don_Vi_Tinh, false)</span></div>
                                <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Ghi chú")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Ghi_Chu, false)</span></div>
                            </div>
                            <div class="col-lg-4">
                                <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Ngày giờ tạo")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Created, false)</span></div>
                                <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Người tạo")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Created_By, false)</span></div>
                                <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Chức năng tạo")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Created_By_Function, false)</span></div>
                            </div>
                            <div class="col-lg-4">
                                <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Ngày cập nhật sau cùng")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Last_Updated, false)</span></div>
                                <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Người cập nhật sau cùng")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Last_Updated_By, false)</span></div>
                                <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Chức năng cập nhật sau cùng")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Last_Updated_By_Function, false)</span></div>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane" id="warehouse_unit_history" role="tabpanel">
                        <FCommon_Record_Action_History_List v_arrData="@m_arrRAH" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private CDM_Don_Vi_Tinh m_objData = new();
    private List<CLog_Record_Action_History> m_arrRAH = new();

    protected override void Load_Data()
    {
        m_objData = new CDM_Don_Vi_Tinh_Controller()
            .F2016_sp_sel_Get_By_ID(r_iAuto_ID)
            ?? throw new InvalidOperationException(Get_Language_Data_Field("Không tìm thấy đơn vị tính cần xem."));

        m_arrRAH = new CLog_Record_Action_History_Controller()
            .FCommon_Sys_sp_sel_List_Log_Record_Action_History(r_iAuto_ID);
    }
}
