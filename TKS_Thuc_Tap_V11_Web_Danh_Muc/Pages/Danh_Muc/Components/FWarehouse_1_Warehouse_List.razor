    private async Task Save_Document_Async(CWarehouseDocument p_objData)
    {
        try
        {
            var v_iAuto_ID = p_objData.Auto_ID;
            if (v_iAuto_ID == 0 && !r_objChuc_Nang.Is_Have_Add_Permission || v_iAuto_ID != 0 && !r_objChuc_Nang.Is_Have_Edit_Permission)
            {
                return;
            }

            p_objData.Is_Receipt = Is_Receipt;
            p_objData.Last_Updated_By = r_strActive_User_Name;
            p_objData.Last_Updated_By_Function = r_strActive_Function_Code;
            if (v_iAuto_ID == 0)
            {
                p_objData.Created_By = r_strActive_User_Name;
                p_objData.Created_By_Function = r_strActive_Function_Code;
            }

            if (Is_Receipt)
            {
                var v_objReceipt = To_Nhap_Kho(p_objData);
                p_objData.Auto_ID = v_iAuto_ID == 0
                    ? m_objNhapKhoController.F3001_sp_ins_Nhap_Kho_Header(v_objReceipt)
                    : m_objNhapKhoController.F3001_sp_upd_Nhap_Kho_Header(v_objReceipt);
            }
            else
            {
                var v_objIssue = To_Xuat_Kho(p_objData);
                p_objData.Auto_ID = v_iAuto_ID == 0
                    ? m_objXuatKhoController.F3002_sp_ins_Xuat_Kho_Header(v_objIssue)
                    : m_objXuatKhoController.F3002_sp_upd_Xuat_Kho_Header(v_objIssue);
            }

            string v_strAction;
            if (v_iAuto_ID == 0)
            {
                v_strAction = "Thêm mới";
            }
            else
            {
                v_strAction = "Hiệu chỉnh";
            }

            Try_Record_Action_History(p_objData.Auto_ID, v_strAction, "Warehouse document " + p_objData.So_Phieu);
            m_grdDocument.Rebind();
            await Select_Document_Async(p_objData);
            Set_Success("Đã lưu phiếu.");
        }
        catch (Exception ex)
        {
            Set_Error(ex);
        }
    }

    private async Task Delete_Document_Async(long p_iAuto_ID)
    {
        try
        {
