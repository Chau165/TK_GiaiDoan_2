    private string Format_Master_Import_Success(int p_iRowCount, string p_strEntity_Name) =>
        string.Format(Get_Language_Data_Field("Đã nhập thành công {0} {1}."), p_iRowCount, Get_Language_Data_Field(p_strEntity_Name));

    private async Task Complete_Master_Import_Async(int p_iRowCount, string p_strAction, string p_strSuccess_Message)
    {
        Try_Record_Action_History(0, p_strAction, $"Rows: {p_iRowCount}");
        Exception? v_objRefresh_Exception = null;

        r_objLayout.Start_Loading();
        try
        {
            try
            {
                await Load_Lookups_Async();
            }
            catch (Exception p_objException)
            {
                v_objRefresh_Exception = p_objException;
            }

            try
            {
                m_grdMaster.Rebind();
            }
            catch (Exception p_objException)
            {
                v_objRefresh_Exception ??= p_objException;
            }
        }
        finally
        {
            r_objLayout.Stop_Loading();
        }

        if (v_objRefresh_Exception is null)
        {
            Set_Success(p_strSuccess_Message);
            return;
        }

        Set_Error(new InvalidOperationException(
            string.Format(Get_Language_Data_Field("Đã nhập thành công {0} dòng, nhưng không thể làm mới lookup hoặc danh sách. Hãy tải lại màn hình."), p_iRowCount),
            v_objRefresh_Exception));
    }

    private void Edit_Master(CWarehouseMaster p_objData)
    {
        if (!Try_Refresh_Product_Unit_Lookup())
            return;

        r_iAuto_ID = p_objData.Auto_ID;
        switch (m_strMaster_Type)
        {
            case "Kho":
                m_objKho = new CDM_Kho { Auto_ID = p_objData.Auto_ID, Ten_Kho = p_objData.Name, Ghi_Chu = p_objData.Ghi_Chu };
                break;
            case "DonViTinh":
                m_objDon_Vi_Tinh = new CDM_Don_Vi_Tinh { Auto_ID = p_objData.Auto_ID, Ten_Don_Vi_Tinh = p_objData.Name, Ghi_Chu = p_objData.Ghi_Chu };
                break;
            case "LoaiSanPham":
                m_objLoai_San_Pham = new CDM_Loai_San_Pham { Auto_ID = p_objData.Auto_ID, Ma_LSP = p_objData.Code, Ten_LSP = p_objData.Name, Ghi_Chu = p_objData.Ghi_Chu };
                break;
            case "SanPham":
                m_objSan_Pham = new CDM_San_Pham
                {
                    Auto_ID = p_objData.Auto_ID,
                    Ma_San_Pham = p_objData.Code,
                    Ten_San_Pham = p_objData.Name,
                    Loai_San_Pham_ID = p_objData.Related_ID,
                    Don_Vi_Tinh_ID = p_objData.Related_ID_2,
                    Ghi_Chu = p_objData.Ghi_Chu
                };
                break;
            case "NCC":
                m_objNCC = new CDM_NCC { Auto_ID = p_objData.Auto_ID, Ma_NCC = p_objData.Code, Ten_NCC = p_objData.Name, Ghi_Chu = p_objData.Ghi_Chu };
                break;
            default:
                throw new ArgumentException("Loại danh mục không hợp lệ.", nameof(m_strMaster_Type));
        }
        r_bIs_Show_Edit = true;
        Clear_Message();
    }

