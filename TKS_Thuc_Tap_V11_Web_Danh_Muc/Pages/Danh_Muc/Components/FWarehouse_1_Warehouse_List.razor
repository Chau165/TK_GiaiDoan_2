@inherits FBase

<div class="card">
    <div class="card-header d-flex gap-2 flex-wrap">
        <button class="btn @(m_strSection == "Master" ? "btn-primary" : "btn-light")" @onclick="@(() => Select_Section_Async("Master"))">Danh mục</button>
        <button class="btn @(m_strSection == "Receipt" ? "btn-primary" : "btn-light")" @onclick="@(() => Select_Section_Async("Receipt"))">Phiếu nhập</button>
        <button class="btn @(m_strSection == "Issue" ? "btn-primary" : "btn-light")" @onclick="@(() => Select_Section_Async("Issue"))">Phiếu xuất</button>
        <button class="btn @(m_strSection == "Report" ? "btn-primary" : "btn-light")" @onclick="@(() => Select_Section_Async("Report"))">Báo cáo</button>
    </div>
    <div class="card-body">
        @((MarkupString)r_strError)
        @if (!String.IsNullOrWhiteSpace(m_strSuccess))
        {
            <div class="alert alert-success">@m_strSuccess</div>
        }

        @if (m_strSection == "Master")
        {
            <div class="d-flex justify-content-between align-items-end gap-3">
                <div style="min-width: 280px;"><label class="form-label">Loại danh mục</label><select class="form-select" @bind="m_strMaster_Type" @bind:after="Load_Master_Async"><option value="DonViTinh">Đơn vị tính</option><option value="LoaiSanPham">Loại sản phẩm</option><option value="SanPham">Sản phẩm</option><option value="NCC">Nhà cung cấp</option><option value="Kho">Kho</option><option value="KhoUser">Phân quyền kho - user</option></select></div>
                <div class="d-flex gap-2">
                    @if (r_objChuc_Nang.Is_Have_Add_Permission)
                    {
                        <button type="button" class="btn btn-primary" @onclick="New_Master">Thêm</button>
                    }
                    @Layout_Tool_Button(m_grdMaster)
                </div>
            </div>
            <h5 class="mt-3">Danh sách @((m_strMaster_Type == "KhoUser") ? "phân quyền kho - user" : "danh mục")</h5>
            <TelerikGrid Data="@m_arrMaster" Height="calc(100vh - 310px)" Resizable="true" Reorderable="true" @ref="m_grdMaster">
                <GridExport><GridExcelExport FileName="Warehouse_Master_Export" AllPages="true" /><GridCsvExport FileName="Warehouse_Master_Export" AllPages="true" /></GridExport>
                <GridColumns>
                    <GridColumn Width="70px">
                        <Template>
                            <button type="button" class="btn btn-link" title="Xem" @onclick="@(() => Open_Master_Info((context as CWarehouseMaster)))">
                                <i class="mdi mdi-eye" style="color: purple;"></i>
                            </button>
                            @if (r_objChuc_Nang.Is_Have_Edit_Permission || r_objChuc_Nang.Is_Have_Delete_Permission)
                            {
                                <button type="button" class="btn btn-link" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="mdi mdi-cog-outline" style="color: purple;"></i>
                                </button>
                                <ul class="dropdown-menu">
                                    @if (r_objChuc_Nang.Is_Have_Edit_Permission)
                                    {
                                        <li><button class="dropdown-item" type="button" @onclick="@(() => Edit_Master((context as CWarehouseMaster)))"><i class="ri-edit-2-line align-bottom me-1"></i>&nbsp; Hiệu chỉnh</button></li>
                                    }
                                    @if (r_objChuc_Nang.Is_Have_Delete_Permission)
                                    {
                                        <li><button class="dropdown-item" type="button" @onclick="@(() => Delete_Master_Async((context as CWarehouseMaster).Auto_ID))"><i class="ri-delete-bin-line align-bottom me-1"></i>&nbsp; Xóa</button></li>
                                    }
                                </ul>
                            }
                        </Template>
                    </GridColumn>
                    @if (CCache_Grid_UI_Global.List_Data_By_Code("2010", "grdMaster").Count > 0)
                    {
                        <FCommon_General_Col_Grid m_strFCode="2010" m_strTen_Grid="grdMaster" />
                    }
                    else
                    {
                        <GridColumn Field="Code" Title="Mã" Width="140px" /><GridColumn Field="Name" Title="Tên / đăng nhập" Width="240px" /><GridColumn Field="Ghi_Chu" Title="Ghi chú" /><GridColumn Field="Related_ID" Title="Liên kết" Width="100px" />
                    }
                </GridColumns>
            </TelerikGrid>
        }

        @if (m_strSection is "Receipt" or "Issue")
        {
            <div class="d-flex justify-content-between align-items-center mb-3"><h5 class="mb-0">@(Is_Receipt ? "Quản lý phiếu nhập" : "Quản lý phiếu xuất")</h5><div class="d-flex gap-2">@Layout_Tool_Button(m_grdDocument)@if (r_objChuc_Nang.Is_Have_Add_Permission){<button class="btn btn-primary" @onclick="New_Document">Tạo phiếu mới</button>}</div></div>
            @if (m_bDocumentEditing)
            {
                <FWarehouse_3_Warehouse_Edit m_strEditor_Type="Document" m_bIs_Receipt="@Is_Receipt" m_objDocument="@m_objDocument" m_arrSupplier="@m_arrSupplier" m_arrWarehouse="@m_arrWarehouse" OnSave_Document="Save_Document_Async" OnCancel="Cancel_Document" />
            }
            <TelerikGrid Data="@m_arrDocument" Height="calc(100vh - 310px)" Resizable="true" Reorderable="true" @ref="m_grdDocument">
                <GridExport><GridExcelExport FileName="Warehouse_Document_Export" AllPages="true" /><GridCsvExport FileName="Warehouse_Document_Export" AllPages="true" /></GridExport>
                <GridColumns>
                    <GridColumn Field="Ngay_Chung_Tu" Title="Ngày" Width="120px" /><GridColumn Field="So_Phieu" Title="Số phiếu" Width="160px" /><GridColumn Field="Ten_Kho" Title="Kho" Width="180px" />@if (Is_Receipt){<GridColumn Field="Ten_NCC" Title="NCC" Width="180px" />}<GridColumn Field="Ghi_Chu" Title="Ghi chú" />
                    <GridColumn Title=""><Template Context="v_objContext"><button type="button" class="btn btn-sm btn-outline-primary me-1" @onclick="@(() => Select_Document_Async((CWarehouseDocument)v_objContext))">Chi tiết</button>@if(r_objChuc_Nang.Is_Have_Edit_Permission){<button type="button" class="btn btn-sm btn-outline-secondary me-1" @onclick="@(() => Edit_Document((CWarehouseDocument)v_objContext))">Sửa</button>}@if(r_objChuc_Nang.Is_Have_Delete_Permission){<button type="button" class="btn btn-sm btn-outline-danger" @onclick="@(() => Delete_Document_Async(((CWarehouseDocument)v_objContext).Auto_ID))">Xóa</button>}</Template></GridColumn>
                </GridColumns>
            </TelerikGrid>
            @if (m_bDetailEditing)
            {
                <FWarehouse_3_Warehouse_Edit m_strEditor_Type="Detail" m_bIs_Receipt="@Is_Receipt" m_objDetail="@m_objDetail" m_arrProduct="@m_arrProduct" OnSave_Detail="Save_Detail_Async" OnCancel="Cancel_Detail" />
            }
            <FWarehouse_2_Warehouse_Info m_objDocument="@m_objSelectedDocument" m_arrDetail="@m_arrDetail" m_bIs_Receipt="@Is_Receipt" m_bCan_Add="@r_objChuc_Nang.Is_Have_Add_Permission" m_bCan_Edit="@r_objChuc_Nang.Is_Have_Edit_Permission" m_bCan_Delete="@r_objChuc_Nang.Is_Have_Delete_Permission" m_bCan_Export="@r_objChuc_Nang.Is_Have_Export_Permission" OnAdd_Detail="New_Detail" OnEdit_Detail="Edit_Detail" OnDelete_Detail="Delete_Detail_Async" OnPrint="Print_Async" />
        }

        @if (m_strSection == "Report")
        {
            <div class="row g-3 align-items-end"><div class="col-md-3"><label class="form-label">Báo cáo</label><select class="form-select" @bind="m_strReport_Type"><option value="Receipt">Chi tiết hàng nhập</option><option value="Issue">Chi tiết hàng xuất</option><option value="Inventory">Xuất nhập tồn</option></select></div><div class="col-md-3"><label class="form-label">Từ ngày</label><TelerikDatePicker @bind-Value="m_dtmFrom" Format="@CConfig.Date_Format_String" /></div><div class="col-md-3"><label class="form-label">Đến ngày</label><TelerikDatePicker @bind-Value="m_dtmTo" Format="@CConfig.Date_Format_String" /></div><div class="col-md-2"><button class="btn btn-primary" @onclick="Load_Report_Async">Xem báo cáo</button></div></div>
            @if (m_strReport_Type == "Inventory")
            {
                <TelerikGrid Data="@m_arrInventoryReport" Height="calc(100vh - 310px)" Resizable="true" Reorderable="true" @ref="m_grdInventory"><GridExport><GridExcelExport FileName="Warehouse_Inventory_Export" AllPages="true" /><GridCsvExport FileName="Warehouse_Inventory_Export" AllPages="true" /></GridExport><GridColumns><GridColumn Field="Ten_Kho" Title="Kho" /><GridColumn Field="Ma_San_Pham" Title="Mã SP" /><GridColumn Field="Ten_San_Pham" Title="Tên SP" /><GridColumn Field="SL_Dau_Ky" Title="SL đầu kỳ" /><GridColumn Field="SL_Nhap" Title="SL nhập" /><GridColumn Field="SL_Xuat" Title="SL xuất" /><GridColumn Field="SL_Cuoi_Ky" Title="SL cuối kỳ" /></GridColumns></TelerikGrid>
            }
            else
            {
                <TelerikGrid Data="@m_arrDetailReport" Height="calc(100vh - 310px)" Resizable="true" Reorderable="true" @ref="m_grdReportDetail"><GridExport><GridExcelExport FileName="Warehouse_Report_Export" AllPages="true" /><GridCsvExport FileName="Warehouse_Report_Export" AllPages="true" /></GridExport><GridColumns><GridColumn Field="Ngay" Title="Ngày" /><GridColumn Field="So_Phieu" Title="Số phiếu" />@if(m_strReport_Type=="Receipt"){<GridColumn Field="Nha_Cung_Cap" Title="NCC" />}<GridColumn Field="Ma_San_Pham" Title="Mã SP" /><GridColumn Field="Ten_San_Pham" Title="Tên SP" /><GridColumn Field="So_Luong" Title="SL" /><GridColumn Field="Don_Gia" Title="Đơn giá" /><GridColumn Field="Tri_Gia" Title="Trị giá" /></GridColumns></TelerikGrid>
            }
            @if (r_objChuc_Nang.Is_Have_Export_Permission)
            {
                <div class="mt-2">@if(m_strReport_Type=="Inventory"){@Layout_Tool_Button(m_grdInventory)}else{@Layout_Tool_Button(m_grdReportDetail)}</div>
            }
        }
    </div>
</div>

@if (r_bIs_Show_Info)
{
    <FWarehouse_2_Warehouse_Master_Info m_objData="@m_objMaster" m_strMaster_Type="@m_strMaster_Type" OnClose="@Close_Info" />
}

@if (r_bIs_Show_Edit)
{
    <FWarehouse_3_Warehouse_Master_Edit m_strMaster_Type="@m_strMaster_Type" m_objMaster="@m_objMaster" m_arrUnit="@m_arrUnit" m_arrCategory="@m_arrCategory" m_arrWarehouse="@m_arrWarehouse" OnSave_Master="Save_Master_Async" OnClose="@Close_Edit" />
}

@code {
    private readonly CWarehouseMaster_Controller m_objMasterController = new();
    private readonly CWarehouseDocument_Controller m_objDocumentController = new();
    private readonly CWarehouseReport_Controller m_objReportController = new();
    private string m_strSection = "Master", m_strMaster_Type = "DonViTinh", m_strReport_Type = "Receipt", m_strSuccess = "";
    private CWarehouseMaster m_objMaster = new();
    private CWarehouseDocument m_objDocument = new();
    private CWarehouseDocument? m_objSelectedDocument;
    private CWarehouseDocumentDetail m_objDetail = new();
    private List<CWarehouseMaster> m_arrMaster = new();
    private List<CWarehouseDocument> m_arrDocument = new();
    private List<CWarehouseDocumentDetail> m_arrDetail = new();
    private List<CWarehouseLookup> m_arrUnit = new(), m_arrCategory = new(), m_arrProduct = new(), m_arrSupplier = new(), m_arrWarehouse = new();
    private List<CWarehouseDetailReport> m_arrDetailReport = new();
    private List<CWarehouseInventoryReport> m_arrInventoryReport = new();
    private DateTime m_dtmFrom = new(DateTime.Today.Year, DateTime.Today.Month, 1), m_dtmTo = DateTime.Today;
    private bool m_bDocumentEditing;
    private bool m_bDetailEditing;
    private bool Is_Receipt => m_strSection == "Receipt";
    private TelerikGrid<CWarehouseMaster> m_grdMaster = new();
    private TelerikGrid<CWarehouseDocument> m_grdDocument = new();
    private TelerikGrid<CWarehouseDetailReport> m_grdReportDetail = new();
    private TelerikGrid<CWarehouseInventoryReport> m_grdInventory = new();

    protected override void Init_Data()
    {
        m_bDocumentEditing = false;
        m_bDetailEditing = false;
    }

    protected override void Load_Data()
    {
        r_strError = "";
        m_strSuccess = "";
    }

    protected override async Task Load_Data_Async()
    {
        await Load_Lookups_Async();
        if (m_strSection == "Master") await Load_Master_Async();
        else if (m_strSection is "Receipt" or "Issue") await Load_Documents_Async();
    }

    private async Task Select_Section_Async(string p_strSection)
    {
        m_strSection = p_strSection;
        Clear_Message();
        r_bIs_Show_Info = false; r_bIs_Show_Edit = false; m_bDocumentEditing = false; m_bDetailEditing = false; m_objSelectedDocument = null; m_arrDetail.Clear();
        if (p_strSection == "Master") await Load_Master_Async();
        else if (p_strSection is "Receipt" or "Issue") { m_objDocument = New_Document_Model(); await Load_Documents_Async(); }
    }

    private async Task Load_Lookups_Async()
    {
        m_arrUnit = await m_objMasterController.List_Lookup_Async("DonViTinh");
        m_arrCategory = await m_objMasterController.List_Lookup_Async("LoaiSanPham");
        m_arrProduct = await m_objMasterController.List_Lookup_Async("SanPham");
        m_arrSupplier = await m_objMasterController.List_Lookup_Async("NCC");
        m_arrWarehouse = await m_objMasterController.List_Lookup_Async("Kho");
    }

    private async Task Load_Master_Async()
    {
        try { Clear_Message(); m_arrMaster = await m_objMasterController.List_Master_Async(m_strMaster_Type); Cancel_Master(); }
        catch (Exception ex) { Set_Error(ex); }
    }

    private async Task Save_Master_Async(CWarehouseMaster p_objData)
    {
        try { var v_iAuto_ID = p_objData.Auto_ID; if (v_iAuto_ID == 0 && !r_objChuc_Nang.Is_Have_Add_Permission || v_iAuto_ID != 0 && !r_objChuc_Nang.Is_Have_Edit_Permission) return; await m_objMasterController.Save_Master_Async(m_strMaster_Type, p_objData, r_strActive_User_Name, r_strActive_Function_Code); CCommon_Controller.FCommon_Insert_Action_History(p_objData.Auto_ID, v_iAuto_ID == 0 ? "Thêm mới" : "Hiệu chỉnh", "Web", r_strActive_User_Name, r_strActive_Function_Code, r_objChuc_Nang.Ten_Chuc_Nang, "Warehouse " + m_strMaster_Type); await Load_Lookups_Async(); await Load_Master_Async(); Set_Success("Đã lưu danh mục."); }
        catch (Exception ex) { Set_Error(ex); }
    }

    private void New_Master() { m_objMaster = new(); r_bIs_Show_Edit = true; Clear_Message(); }
    private void Edit_Master(CWarehouseMaster p_objData) { r_iAuto_ID = p_objData.Auto_ID; m_objMaster = Clone_Master(p_objData); r_bIs_Show_Edit = true; Clear_Message(); }
    private void Open_Master_Info(CWarehouseMaster p_objData) { r_iAuto_ID = p_objData.Auto_ID; m_objMaster = Clone_Master(p_objData); r_bIs_Show_Info = true; Clear_Message(); }
    private void Cancel_Master() { m_objMaster = new(); r_bIs_Show_Edit = false; }

    private async Task Delete_Master_Async(long p_iAuto_ID)
    {
        try { await m_objMasterController.Delete_Master_Async(m_strMaster_Type, p_iAuto_ID, r_strActive_User_Name, r_strActive_Function_Code); CCommon_Controller.FCommon_Insert_Action_History(p_iAuto_ID, "Xóa", "Web", r_strActive_User_Name, r_strActive_Function_Code, r_objChuc_Nang.Ten_Chuc_Nang, "Warehouse " + m_strMaster_Type); await Load_Lookups_Async(); await Load_Master_Async(); Set_Success("Đã xóa danh mục."); }
        catch (Exception ex) { Set_Error(ex); }
    }

    private void New_Document() { m_objDocument = New_Document_Model(); m_objSelectedDocument = null; m_arrDetail.Clear(); m_objDetail = new(); m_bDocumentEditing = true; m_bDetailEditing = false; Clear_Message(); }
    private CWarehouseDocument New_Document_Model() => new() { Is_Receipt = Is_Receipt, Ngay_Chung_Tu = DateTime.Today };
    private async Task Load_Documents_Async() { try { m_arrDocument = await m_objDocumentController.List_Documents_Async(Is_Receipt); } catch (Exception ex) { Set_Error(ex); } }
    private void Cancel_Document() { m_bDocumentEditing = false; m_objDocument = New_Document_Model(); }
    private void Edit_Document(CWarehouseDocument p_objData) { m_objDocument = Clone_Document(p_objData); m_objSelectedDocument = null; m_arrDetail.Clear(); m_bDocumentEditing = true; m_bDetailEditing = false; Clear_Message(); }

    private async Task Save_Document_Async(CWarehouseDocument p_objData)
    {
        try { var v_iAuto_ID = p_objData.Auto_ID; if (v_iAuto_ID == 0 && !r_objChuc_Nang.Is_Have_Add_Permission || v_iAuto_ID != 0 && !r_objChuc_Nang.Is_Have_Edit_Permission) return; p_objData.Is_Receipt = Is_Receipt; await m_objDocumentController.Save_Document_Async(p_objData, r_strActive_User_Name, r_strActive_Function_Code); CCommon_Controller.FCommon_Insert_Action_History(p_objData.Auto_ID, v_iAuto_ID == 0 ? "Thêm mới" : "Hiệu chỉnh", "Web", r_strActive_User_Name, r_strActive_Function_Code, r_objChuc_Nang.Ten_Chuc_Nang, "Warehouse document " + p_objData.So_Phieu); var v_objSaved = (await m_objDocumentController.List_Documents_Async(Is_Receipt)).FirstOrDefault(x => x.Auto_ID == p_objData.Auto_ID); if (v_objSaved == null) throw new InvalidOperationException("Không tìm thấy phiếu vừa lưu."); m_arrDocument = await m_objDocumentController.List_Documents_Async(Is_Receipt); await Select_Document_Async(v_objSaved); Set_Success("Đã lưu phiếu."); }
        catch (Exception ex) { Set_Error(ex); }
    }

    private async Task Delete_Document_Async(long p_iAuto_ID)
    {
        try { await m_objDocumentController.Delete_Document_Async(Is_Receipt, p_iAuto_ID, r_strActive_User_Name, r_strActive_Function_Code); CCommon_Controller.FCommon_Insert_Action_History(p_iAuto_ID, "Xóa", "Web", r_strActive_User_Name, r_strActive_Function_Code, r_objChuc_Nang.Ten_Chuc_Nang, "Warehouse document"); Cancel_Document(); m_objSelectedDocument = null; m_arrDetail.Clear(); await Load_Documents_Async(); Set_Success("Đã xóa phiếu."); }
        catch (Exception ex) { Set_Error(ex); }
    }

    private async Task Select_Document_Async(CWarehouseDocument p_objData)
    {
        try { m_objSelectedDocument = p_objData; m_objDocument = Clone_Document(p_objData); m_arrDetail = await m_objDocumentController.List_Document_Details_Async(Is_Receipt, p_objData.Auto_ID); m_objDetail = new() { Document_ID = p_objData.Auto_ID }; m_bDocumentEditing = false; m_bDetailEditing = false; }
        catch (Exception ex) { Set_Error(ex); }
    }

    private void New_Detail() { if (m_objSelectedDocument == null || !r_objChuc_Nang.Is_Have_Add_Permission) return; m_objDetail = new() { Document_ID = m_objSelectedDocument.Auto_ID }; m_bDetailEditing = true; Clear_Message(); }
    private void Cancel_Detail() { if (m_objSelectedDocument == null) return; m_objDetail = new() { Document_ID = m_objSelectedDocument.Auto_ID }; m_bDetailEditing = false; }
    private void Edit_Detail(CWarehouseDocumentDetail p_objData) { if (!r_objChuc_Nang.Is_Have_Edit_Permission) return; m_objDetail = Clone_Detail(p_objData); m_bDetailEditing = true; Clear_Message(); }

    private async Task Save_Detail_Async(CWarehouseDocumentDetail p_objData)
    {
        try { if (m_objSelectedDocument == null || p_objData.Auto_ID == 0 && !r_objChuc_Nang.Is_Have_Add_Permission || p_objData.Auto_ID != 0 && !r_objChuc_Nang.Is_Have_Edit_Permission) return; p_objData.Document_ID = m_objSelectedDocument.Auto_ID; var v_iAuto_ID = p_objData.Auto_ID; await m_objDocumentController.Save_Document_Detail_Async(Is_Receipt, p_objData, r_strActive_User_Name, r_strActive_Function_Code); CCommon_Controller.FCommon_Insert_Action_History(p_objData.Auto_ID, v_iAuto_ID == 0 ? "Thêm mới" : "Hiệu chỉnh", "Web", r_strActive_User_Name, r_strActive_Function_Code, r_objChuc_Nang.Ten_Chuc_Nang, "Warehouse detail"); await Select_Document_Async(m_objSelectedDocument); Set_Success("Đã lưu chi tiết."); }
        catch (Exception ex) { Set_Error(ex); }
    }

    private async Task Delete_Detail_Async(long p_iAuto_ID)
    {
        try { if (m_objSelectedDocument == null || !r_objChuc_Nang.Is_Have_Delete_Permission) return; await m_objDocumentController.Delete_Document_Detail_Async(Is_Receipt, p_iAuto_ID, r_strActive_User_Name, r_strActive_Function_Code); CCommon_Controller.FCommon_Insert_Action_History(p_iAuto_ID, "Xóa", "Web", r_strActive_User_Name, r_strActive_Function_Code, r_objChuc_Nang.Ten_Chuc_Nang, "Warehouse detail"); await Select_Document_Async(m_objSelectedDocument); Set_Success("Đã xóa chi tiết."); }
        catch (Exception ex) { Set_Error(ex); }
    }

    private async Task Load_Report_Async()
    {
        try { Clear_Message(); if (m_strReport_Type == "Inventory") m_arrInventoryReport = await m_objReportController.Inventory_Report_Async(m_dtmFrom, m_dtmTo); else m_arrDetailReport = await m_objReportController.Detail_Report_Async(m_strReport_Type == "Receipt", m_dtmFrom, m_dtmTo); }
        catch (Exception ex) { Set_Error(ex); }
    }

    private Task Print_Async() => r_objChuc_Nang.Is_Have_Export_Permission ? g_jsRuntime.InvokeVoidAsync("print").AsTask() : Task.CompletedTask;
    private void Clear_Message() { r_strError = ""; m_strSuccess = ""; }
    private void Set_Success(string p_strText) { r_strError = ""; m_strSuccess = p_strText; }
    private void Set_Error(Exception p_objException) { m_strSuccess = ""; r_strError = CCommonFunction.Set_Error_MessageBox(p_objException.Message); }
    private static CWarehouseMaster Clone_Master(CWarehouseMaster p_objData) => new() { Auto_ID = p_objData.Auto_ID, Code = p_objData.Code, Name = p_objData.Name, Related_ID = p_objData.Related_ID, Related_ID_2 = p_objData.Related_ID_2, Login_Name = p_objData.Login_Name, Ghi_Chu = p_objData.Ghi_Chu };
    private static CWarehouseDocument Clone_Document(CWarehouseDocument p_objData) => new() { Auto_ID = p_objData.Auto_ID, Is_Receipt = p_objData.Is_Receipt, So_Phieu = p_objData.So_Phieu, Kho_ID = p_objData.Kho_ID, NCC_ID = p_objData.NCC_ID, Ten_Kho = p_objData.Ten_Kho, Ten_NCC = p_objData.Ten_NCC, Ngay_Chung_Tu = p_objData.Ngay_Chung_Tu, Ghi_Chu = p_objData.Ghi_Chu };
    private static CWarehouseDocumentDetail Clone_Detail(CWarehouseDocumentDetail p_objData) => new() { Auto_ID = p_objData.Auto_ID, Document_ID = p_objData.Document_ID, San_Pham_ID = p_objData.San_Pham_ID, So_Luong = p_objData.So_Luong, Don_Gia = p_objData.Don_Gia, Ma_San_Pham = p_objData.Ma_San_Pham, Ten_San_Pham = p_objData.Ten_San_Pham };
}
