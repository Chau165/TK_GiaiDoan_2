    private async Task Save_Master_Operation_Async(
        bool p_bIsAdd,
        Action p_actSave,
        Func<long> p_fncGetAuto_ID,
        string p_strMaster_Type)
    {
        if (p_bIsAdd && !r_objChuc_Nang.Is_Have_Add_Permission || !p_bIsAdd && !r_objChuc_Nang.Is_Have_Edit_Permission)
            return;

        await Task.Delay(1);
        long v_iQueue_ID = 0;
        r_objLayout.Start_Loading();
        try
        {
            v_iQueue_ID = Process_Queue("Warehouse Master Save - " + p_strMaster_Type);
            p_actSave();
            Try_Record_Action_History(p_fncGetAuto_ID(), p_bIsAdd ? "Thêm mới" : "Hiệu chỉnh", "Warehouse " + p_strMaster_Type);
            await Load_Lookups_Async();
            await Load_Master_Async();
            Set_Success(Get_Language_Data_Field("Đã lưu danh mục."));
        }
        catch (Exception ex)
        {
            Set_Error(ex);
        }
        finally
        {
            if (v_iQueue_ID > 0)
                End_Queue(v_iQueue_ID);
            r_objLayout.Stop_Loading();
        }
    }

    private async Task Save_Kho_User_Async(CWarehousePermission p_objData)
    {
        var v_iPermission_ID = p_objData.Permission_ID;
        if (v_iPermission_ID == 0 && !r_objChuc_Nang.Is_Have_Add_Permission || v_iPermission_ID != 0 && !r_objChuc_Nang.Is_Have_Edit_Permission)
            return;

        await Task.Delay(1);
        long v_iQueue_ID = 0;
        r_objLayout.Start_Loading();
        try
        {
            v_iQueue_ID = Process_Queue("Warehouse Master Save - KhoUser");
            CDM_Kho_User v_objKhoUser = To_Kho_User_Entity(p_objData);
            if (v_iPermission_ID == 0)
            {
                p_objData.Permission_ID = m_objPermissionController.F2015_sp_ins_Kho_User(
                    v_objKhoUser,
                    r_strActive_User_Name,
                    r_strActive_Function_Code);
            }
            else
            {
                p_objData.Permission_ID = m_objPermissionController.F2015_sp_upd_Kho_User(
                    v_objKhoUser,
                    r_strActive_User_Name,
                    r_strActive_Function_Code);
            }

            string v_strAction;
            if (v_iPermission_ID == 0)
            {
                v_strAction = "Thêm mới";
            }
            else
            {
                v_strAction = "Hiệu chỉnh";
            }

            Try_Record_Action_History(p_objData.Permission_ID, v_strAction, "Warehouse " + m_strMaster_Type);
            await Load_Lookups_Async();
            await Load_Master_Async();
            Set_Success(Get_Language_Data_Field("Đã lưu danh mục."));
        }
        catch (Exception ex)
        {
            Set_Error(ex);
        }
        finally
        {
            if (v_iQueue_ID > 0)
                End_Queue(v_iQueue_ID);
            r_objLayout.Stop_Loading();
        }
    }

