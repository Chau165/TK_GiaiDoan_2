@using TKS_Thuc_Tap_V11_Web_Danh_Muc.Services
@using TKS_Thuc_Tap_V11_Data_Access.Controller.DM
@using TKS_Thuc_Tap_V11_Data_Access.Controller.Cache
@using TKS_Thuc_Tap_V11_Data_Access.Controller.Warehouse
@using TKS_Thuc_Tap_V11_Data_Access.Controller.XNK
@using TKS_Thuc_Tap_V11_Data_Access.Entity.DM
@using TKS_Thuc_Tap_V11_Data_Access.Entity.XNK
@inherits FBase

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">@Section_Title</h5>
    </div>
    <div class="card-body">
        @((MarkupString)r_strError)
        @if (!String.IsNullOrWhiteSpace(m_strSuccess))
        {
            <div class="alert alert-success">@m_strSuccess</div>
        }
        @if (!String.IsNullOrWhiteSpace(m_strAuditWarning))
        {
            <div class="alert alert-warning">@m_strAuditWarning</div>
        }

        @if (m_strSection == "Master")
        {
            <div class="d-flex justify-content-between align-items-end gap-3">
                @if (!m_bMaster_Type_Only && !m_bWarehouse_Permission_Only)
                {
                    <div style="min-width: 280px;"><label class="form-label">Loại danh mục</label><select class="form-select" @bind="m_strMaster_Type" @bind:after="Load_Master_Async">
                        <option value="DonViTinh">Đơn vị tính</option>
                        <option value="LoaiSanPham">Loại sản phẩm</option>
                        <option value="SanPham">Sản phẩm</option>
                        <option value="NCC">Nhà cung cấp</option>
                        <option value="Kho">Kho</option>
                    </select></div>
                }
                <div class="d-flex gap-2 ms-auto">
                    @if (r_objChuc_Nang.Is_Have_Add_Permission)
                    {
                        <button type="button" class="btn btn-primary" @onclick="New_Master">Thêm</button>
                    }
                    @if (m_strMaster_Type == "KhoUser")
                    {
                        @Layout_Tool_Button(m_grdPermission)
                    }
                    else
                    {
                        @Layout_Tool_Button(m_grdMaster, Can_Import_Selected_Master ? Master_Import_Tool_Item : null)
                    }
                </div>
            </div>
            <h5 class="mt-3">Danh sách @Master_Type_Title</h5>
            @if (m_strMaster_Type == "KhoUser")
            {
                <TelerikGrid TItem="CWarehousePermission" Height="calc(100vh - 310px)" Resizable="true" Reorderable="true" Pageable="true" PageSize="10" OnRead="Read_Kho_User_Async" @ref="m_grdPermission">
                    <GridExport><GridExcelExport FileName="Warehouse_Master_Export" AllPages="true" OnBeforeExport="Prepare_Excel_Export" /><GridCsvExport FileName="Warehouse_Master_Export" AllPages="true" /></GridExport>
                    <GridColumns>
                        <GridColumn Width="70px">
                            <Template>
                                <button type="button" class="btn btn-link" title="Xem" @onclick="@(() => Open_Kho_User_Info((context as CWarehousePermission)))">
                                    <i class="mdi mdi-eye" style="color: purple;"></i>
                                </button>
                                @if (r_objChuc_Nang.Is_Have_Edit_Permission || r_objChuc_Nang.Is_Have_Delete_Permission)
                                {
                                    <button type="button" class="btn btn-link" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="mdi mdi-cog-outline" style="color: purple;"></i>
                                    </button>
                                    <ul class="dropdown-menu">
                                        @if (r_objChuc_Nang.Is_Have_Edit_Permission)
                                        {
                                            <li><button class="dropdown-item" type="button" @onclick="@(() => Edit_Kho_User((context as CWarehousePermission)))"><i class="ri-edit-2-line align-bottom me-1"></i>&nbsp; Hiệu chỉnh</button></li>
                                        }
                                        @if (r_objChuc_Nang.Is_Have_Delete_Permission)
                                        {
                                            <li><button class="dropdown-item" type="button" @onclick="@(() => Delete_Kho_User_Async((context as CWarehousePermission).Permission_ID))"><i class="ri-delete-bin-line align-bottom me-1"></i>&nbsp; Xóa</button></li>
                                        }
                                    </ul>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="Login_Name" Title="Mã đăng nhập" Width="180px" ShowFilterCellButtons="false" /><GridColumn Field="User_Name" Title="Họ tên" Width="240px" ShowFilterCellButtons="false" /><GridColumn Field="Warehouse_Name" Title="Tên kho" ShowFilterCellButtons="false" />
                    </GridColumns>
                </TelerikGrid>
            }
            else
            {
                <TelerikGrid TItem="CWarehouseMaster" Height="calc(100vh - 310px)" Resizable="true" Reorderable="true" Pageable="true" PageSize="10" OnRead="Read_Master_Async" @ref="m_grdMaster">
                    <GridExport><GridExcelExport FileName="Warehouse_Master_Export" AllPages="true" OnBeforeExport="Prepare_Excel_Export" /><GridCsvExport FileName="Warehouse_Master_Export" AllPages="true" /></GridExport>
                    <GridColumns>
                        <GridColumn Width="70px">
                            <Template>
                                <button type="button" class="btn btn-link" title="Xem" @onclick="@(() => Open_Master_Info((context as CWarehouseMaster)))">
                                    <i class="mdi mdi-eye" style="color: purple;"></i>
                                </button>
                                @if (r_objChuc_Nang.Is_Have_Edit_Permission || r_objChuc_Nang.Is_Have_Delete_Permission)
                                {
                                    <button type="button" class="btn btn-link" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="mdi mdi-cog-outline" style="color: purple;"></i>
                                    </button>
                                    <ul class="dropdown-menu">
                                        @if (r_objChuc_Nang.Is_Have_Edit_Permission)
                                        {
                                            <li><button class="dropdown-item" type="button" @onclick="@(() => Edit_Master((context as CWarehouseMaster)))"><i class="ri-edit-2-line align-bottom me-1"></i>&nbsp; Hiệu chỉnh</button></li>
                                        }
                                        @if (r_objChuc_Nang.Is_Have_Delete_Permission)
                                        {
                                            <li><button class="dropdown-item" type="button" @onclick="@(() => Delete_Master_Async((context as CWarehouseMaster).Auto_ID))"><i class="ri-delete-bin-line align-bottom me-1"></i>&nbsp; Xóa</button></li>
                                        }
                                    </ul>
                                }
                            </Template>
                        </GridColumn>
                        @if (CCache_Grid_UI_Global.List_Data_By_Code("2010", "grdMaster").Count > 0)
                        {
                            <FCommon_General_Col_Grid m_strFCode="2010" m_strTen_Grid="grdMaster" />
                        }
                        else
                        {
                            <GridColumn Field="Code" Title="Mã" Width="140px" /><GridColumn Field="Name" Title="Tên / đăng nhập" Width="240px" /><GridColumn Field="Ghi_Chu" Title="Ghi chú" /><GridColumn Field="Related_ID" Title="Liên kết" Width="100px" />
                        }
                    </GridColumns>
                </TelerikGrid>
            }
        }

        @if (m_strSection is "Receipt" or "Issue")
        {
            <div class="d-flex justify-content-between align-items-end gap-3 mb-3">
                <div>
                    <h5 class="mb-3">
                        @if (Is_Receipt)
                        {
                            <text>Quản lý phiếu nhập</text>
                        }
                        else
                        {
                            <text>Quản lý phiếu xuất</text>
                        }
                    </h5>
                    <div class="row g-3 align-items-end">
                        <div class="col-md-6">
                            <label class="form-label">Kho</label>
                            <select class="form-select" @bind="m_iDocument_Warehouse_ID">
                                <option value="">Tất cả kho</option>
                                @foreach (var v_objWarehouse in m_arrWarehouse)
                                {
                                    <option value="@v_objWarehouse.Auto_ID">@v_objWarehouse.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-auto">
                            <button class="btn btn-primary" @onclick="Load_Documents_Async">Xem phiếu</button>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    @Layout_Tool_Button(m_grdDocument, Can_Import_Document ? Document_Import_Tool_Item : null)
                    @if (r_objChuc_Nang.Is_Have_Add_Permission)
                    {
                        <button class="btn btn-primary" @onclick="New_Document">Tạo phiếu mới</button>
                    }
                </div>
            </div>
            @if (m_bDocumentEditing)
            {
                <FWarehouse_3_Warehouse_Edit m_strEditor_Type="Document" m_bIs_Receipt="@Is_Receipt" m_objDocument="@m_objDocument" m_arrSupplier="@m_arrSupplier" m_arrWarehouse="@m_arrWarehouse" OnSave_Document="Save_Document_Async" OnCancel="Cancel_Document" />
            }
            <TelerikGrid TItem="CWarehouseDocument" Height="calc(100vh - 310px)" Resizable="true" Reorderable="true" Pageable="true" PageSize="10" OnRead="Read_Document_Async" @ref="m_grdDocument">
                <GridExport><GridExcelExport FileName="Warehouse_Document_Export" AllPages="true" OnBeforeExport="Prepare_Excel_Export" /><GridCsvExport FileName="Warehouse_Document_Export" AllPages="true" /></GridExport>
                <GridColumns>
                    <GridColumn Field="Ngay_Chung_Tu" Title="Ngày" Width="120px" />
                    <GridColumn Field="So_Phieu" Title="Số phiếu" Width="160px" />
                    <GridColumn Field="Ten_Kho" Title="Kho" Width="180px" />
                    @if (Is_Receipt)
                    {
                        <GridColumn Field="Ten_NCC" Title="NCC" Width="180px" />
                    }
                    <GridColumn Title="Trạng thái" Width="100px">
                        <Template Context="v_objContext">
                            @if (((CWarehouseDocument)v_objContext).Is_Posted)
                            {
                                <text>Đã Post</text>
                            }
                            else
                            {
                                <text>Nháp</text>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="Ghi_Chu" Title="Ghi chú" />
                    <GridColumn Title=""><Template Context="v_objContext">@{ var v_objDocument=(CWarehouseDocument)v_objContext; }<button type="button" class="btn btn-sm btn-outline-primary me-1" @onclick="@(() => Select_Document_Async(v_objDocument))">Chi tiết</button>@if(!v_objDocument.Is_Posted && r_objChuc_Nang.Is_Have_Edit_Permission){<button type="button" class="btn btn-sm btn-outline-secondary me-1" @onclick="@(() => Edit_Document(v_objDocument))">Sửa</button>}@if(!v_objDocument.Is_Posted && r_objChuc_Nang.Is_Have_Edit_Permission){<button type="button" class="btn btn-sm btn-success me-1" @onclick="@(() => Post_Document_Async(v_objDocument))">Post</button>}@if(!v_objDocument.Is_Posted && r_objChuc_Nang.Is_Have_Delete_Permission){<button type="button" class="btn btn-sm btn-outline-danger" @onclick="@(() => Delete_Document_Async(v_objDocument.Auto_ID))">Xóa</button>}</Template></GridColumn>
                </GridColumns>
            </TelerikGrid>
            @if (m_bDetailEditing)
            {
                <FWarehouse_3_Warehouse_Edit m_strEditor_Type="Detail" m_bIs_Receipt="@Is_Receipt" m_objDetail="@m_objDetail" m_arrProduct="@m_arrProduct" OnSave_Detail="Save_Detail_Async" OnCancel="Cancel_Detail" />
            }
            <FWarehouse_2_Warehouse_Info m_objDocument="@m_objSelectedDocument" m_arrDetail="@m_arrDetail" m_bIs_Receipt="@Is_Receipt" m_bCan_Add="@r_objChuc_Nang.Is_Have_Add_Permission" m_bCan_Edit="@r_objChuc_Nang.Is_Have_Edit_Permission" m_bCan_Delete="@r_objChuc_Nang.Is_Have_Delete_Permission" m_bCan_Export="@r_objChuc_Nang.Is_Have_Export_Permission" OnAdd_Detail="New_Detail" OnEdit_Detail="Edit_Detail" OnDelete_Detail="Delete_Detail_Async" OnPrint="Print_Async" />
        }

        @if (m_strSection == "Report")
        {
            <div class="row g-3 align-items-end"><div class="col-md-3"><label class="form-label">Báo cáo</label><select class="form-select" @bind="m_strReport_Type"><option value="Receipt">Chi tiết hàng nhập</option><option value="Issue">Chi tiết hàng xuất</option><option value="Inventory">Xuất nhập tồn theo kỳ</option><option value="InventoryCurrent">Tồn kho hiện tại</option></select></div><div class="col-md-3"><label class="form-label">Kho</label><select class="form-select" @bind="m_iReport_Warehouse_ID" @bind:after="Load_Report_Async"><option value="">Tất cả kho</option>@foreach (var v_objWarehouse in m_arrWarehouse){<option value="@v_objWarehouse.Auto_ID">@v_objWarehouse.Name</option>}</select></div>@if (!Is_Current_Inventory_Report){<div class="col-md-2"><label class="form-label">Từ ngày</label><TelerikDatePicker @bind-Value="m_dtmFrom" Format="@CConfig.Date_Format_String" /></div><div class="col-md-2"><label class="form-label">Đến ngày</label><TelerikDatePicker @bind-Value="m_dtmTo" Format="@CConfig.Date_Format_String" /></div>}else{<div class="col-md-4"><div class="form-text">Đọc số dư đã Post tại thời điểm hiện tại; không tính lại nhập/xuất theo kỳ.</div></div>}<div class="col-md-2"><button class="btn btn-primary" @onclick="Load_Report_Async">Xem báo cáo</button></div></div>
            @if (m_strReport_Type is "Inventory" or "InventoryCurrent")
            {
                <TelerikGrid TItem="CWarehouseInventoryReport" Height="calc(100vh - 310px)" Resizable="true" Reorderable="true" Pageable="true" PageSize="10" OnRead="Read_Inventory_Async" @ref="m_grdInventory">
                    <GridExport>
                        <GridExcelExport FileName="Warehouse_Inventory_Export" AllPages="true" OnBeforeExport="Prepare_Excel_Export" />
                        <GridCsvExport FileName="Warehouse_Inventory_Export" AllPages="true" />
                    </GridExport>
                    <GridColumns>
                        <GridColumn Field="Ten_Kho" Title="Kho" />
                        <GridColumn Field="Ma_San_Pham" Title="Mã SP" />
                        <GridColumn Field="Ten_San_Pham" Title="Tên SP" />
                        @if (!Is_Current_Inventory_Report)
                        {
                            <GridColumn Field="SL_Dau_Ky" Title="SL đầu kỳ">
                                <Template Context="v_objContext">@(CUtility.Format_So_Luong(((CWarehouseInventoryReport)v_objContext).SL_Dau_Ky))</Template>
                            </GridColumn>
                            <GridColumn Field="SL_Nhap" Title="SL nhập">
                                <Template Context="v_objContext">@(CUtility.Format_So_Luong(((CWarehouseInventoryReport)v_objContext).SL_Nhap))</Template>
                            </GridColumn>
                            <GridColumn Field="SL_Xuat" Title="SL xuất">
                                <Template Context="v_objContext">@(CUtility.Format_So_Luong(((CWarehouseInventoryReport)v_objContext).SL_Xuat))</Template>
                            </GridColumn>
                            <GridColumn Field="SL_Cuoi_Ky" Title="SL cuối kỳ">
                                <Template Context="v_objContext">@(CUtility.Format_So_Luong(((CWarehouseInventoryReport)v_objContext).SL_Cuoi_Ky))</Template>
                            </GridColumn>
                        }
                        else
                        {
                            <GridColumn Field="SL_Ton_Thuc_Te" Title="Tồn thực tế">
                                <Template Context="v_objContext">@(CUtility.Format_So_Luong(((CWarehouseInventoryReport)v_objContext).SL_Ton_Thuc_Te))</Template>
                            </GridColumn>
                            <GridColumn Field="SL_Dang_Giu" Title="Đang giữ">
                                <Template Context="v_objContext">@(CUtility.Format_So_Luong(((CWarehouseInventoryReport)v_objContext).SL_Dang_Giu))</Template>
                            </GridColumn>
                            <GridColumn Field="SL_Kha_Dung" Title="Khả dụng">
                                <Template Context="v_objContext">@(CUtility.Format_So_Luong(((CWarehouseInventoryReport)v_objContext).SL_Kha_Dung))</Template>
                            </GridColumn>
                        }
                    </GridColumns>
                </TelerikGrid>
            }
            else
            {
            <TelerikGrid @key="m_strReport_Type" TItem="CWarehouseDetailReport" Height="calc(100vh - 310px)" Resizable="true" Reorderable="true" Pageable="true" PageSize="10" OnRead="Read_Report_Detail_Async" @ref="m_grdReportDetail"><GridExport><GridExcelExport FileName="Warehouse_Report_Export" AllPages="true" OnBeforeExport="Prepare_Excel_Export" /><GridCsvExport FileName="Warehouse_Report_Export" AllPages="true" /></GridExport><GridColumns><GridColumn Field="Ngay" Title="Ngày" /><GridColumn Field="So_Phieu" Title="Số phiếu" />@if(m_strReport_Type=="Receipt"){<GridColumn Field="Nha_Cung_Cap" Title="NCC" />}<GridColumn Field="Ma_San_Pham" Title="Mã SP" /><GridColumn Field="Ten_San_Pham" Title="Tên SP" /><GridColumn Field="So_Luong" Title="SL"><Template Context="v_objContext">@(CUtility.Format_So_Luong(((CWarehouseDetailReport)v_objContext).So_Luong))</Template></GridColumn><GridColumn Field="Don_Gia" Title="Đơn giá"><Template Context="v_objContext">@(CUtility.Format_So_Tien(((CWarehouseDetailReport)v_objContext).Don_Gia))</Template></GridColumn><GridColumn Field="Tri_Gia" Title="Trị giá"><Template Context="v_objContext">@(CUtility.Format_So_Tien(((CWarehouseDetailReport)v_objContext).Tri_Gia))</Template></GridColumn></GridColumns></TelerikGrid>
            }
            @if (r_objChuc_Nang.Is_Have_Export_Permission)
            {
                <div class="mt-2">@if(m_strReport_Type is "Inventory" or "InventoryCurrent"){@Layout_Tool_Button(m_grdInventory)}else{@Layout_Tool_Button(m_grdReportDetail)}</div>
            }
        }
    </div>
</div>

@if (r_bIs_Show_Info)
{
    @if (m_strMaster_Type == "KhoUser")
    {
        <FWarehouse_2_Warehouse_Master_Info m_objPermission="@m_objPermission" m_strMaster_Type="@m_strMaster_Type" OnClose="@Close_Info" />
    }
    else
    {
        <FWarehouse_2_Warehouse_Master_Info m_objData="@m_objMaster" m_strMaster_Type="@m_strMaster_Type" OnClose="@Close_Info" />
    }
}

@if (r_bIs_Show_Edit)
{
    @if (m_strMaster_Type == "KhoUser")
    {
        <FWarehouse_3_Warehouse_Master_Edit m_strMaster_Type="@m_strMaster_Type" m_objPermission="@m_objPermission" m_arrUnit="@m_arrUnit" m_arrCategory="@m_arrCategory" m_arrWarehouse="@m_arrAllWarehouse" m_arrWarehouseUser="@m_arrWarehouseUser" m_arrUser="@m_arrUser" OnSave_Permission="Save_Kho_User_Async" OnClose="@Close_Edit" />
    }
    else
    {
        <FWarehouse_3_Warehouse_Master_Edit m_strMaster_Type="@m_strMaster_Type" m_objKho="@m_objKho" m_objDon_Vi_Tinh="@m_objDon_Vi_Tinh" m_objLoai_San_Pham="@m_objLoai_San_Pham" m_objSan_Pham="@m_objSan_Pham" m_objNCC="@m_objNCC" m_arrUnit="@m_arrUnit" m_arrCategory="@m_arrCategory" m_arrWarehouse="@m_arrAllWarehouse" m_arrUser="@m_arrUser" OnAdd_Kho="Add_Kho_Async" OnUpdate_Kho="Update_Kho_Async" OnAdd_Don_Vi_Tinh="Add_Don_Vi_Tinh_Async" OnUpdate_Don_Vi_Tinh="Update_Don_Vi_Tinh_Async" OnAdd_Loai_San_Pham="Add_Loai_San_Pham_Async" OnUpdate_Loai_San_Pham="Update_Loai_San_Pham_Async" OnAdd_San_Pham="Add_San_Pham_Async" OnUpdate_San_Pham="Update_San_Pham_Async" OnAdd_NCC="Add_NCC_Async" OnUpdate_NCC="Update_NCC_Async" OnClose="@Close_Edit" />
    }
}

@if (m_bShow_Product_Import)
{
    <FWarehouse_Product_Import UserName="@r_strActive_User_Name" FunctionCode="@r_strActive_Function_Code" OnClose="Close_Product_Import" OnCompleted="On_Product_Import_Completed" />
}
@if (m_bShow_Unit_Import)
{
    <FWarehouse_Unit_Import UserName="@r_strActive_User_Name" FunctionCode="@r_strActive_Function_Code" OnClose="Close_Unit_Import" OnCompleted="On_Unit_Import_Completed" />
}
@if (m_bShow_Category_Import)
{
    <FWarehouse_Category_Import UserName="@r_strActive_User_Name" FunctionCode="@r_strActive_Function_Code" OnClose="Close_Category_Import" OnCompleted="On_Category_Import_Completed" />
}
@if (m_bShow_Supplier_Import)
{
    <FWarehouse_Supplier_Import UserName="@r_strActive_User_Name" FunctionCode="@r_strActive_Function_Code" OnClose="Close_Supplier_Import" OnCompleted="On_Supplier_Import_Completed" />
}
@if (m_bShow_Warehouse_Import)
{
    <FWarehouse_Kho_Import UserName="@r_strActive_User_Name" FunctionCode="@r_strActive_Function_Code" OnClose="Close_Warehouse_Import" OnCompleted="On_Warehouse_Import_Completed" />
}
@if (m_bShow_Document_Import)
{
    <FWarehouse_Transaction_Import IsReceipt="@Is_Receipt" UserName="@r_strActive_User_Name" FunctionCode="@r_strActive_Function_Code" OnClose="Close_Document_Import" OnCompleted="On_Document_Import_Completed" />
}

@code {
    [Parameter] public string m_strSection { get; set; } = "Master";
    [Parameter] public string m_strInitial_Master_Type { get; set; } = "DonViTinh";
    [Parameter] public string m_strInitial_Report_Type { get; set; } = "Receipt";
    [Parameter] public bool m_bMaster_Type_Only { get; set; }
    [Parameter] public bool m_bWarehouse_Permission_Only { get; set; }

    private readonly CWarehouseMasterSupport_Controller m_objMasterSupportController = new();
    private readonly CDM_Kho_User_Controller m_objPermissionController = new();
    private readonly CXNK_Nhap_Kho_Controller m_objNhapKhoController = new();
    private readonly CXNK_Xuat_Kho_Controller m_objXuatKhoController = new();
    private readonly CWarehouseDocumentSupport_Controller m_objDocumentSupportController = new();
    private readonly CWarehouseReport_Controller m_objReportController = new();
    private string m_strMaster_Type = "DonViTinh", m_strReport_Type = "Receipt", m_strSuccess = "", m_strAuditWarning = "";
    private bool m_bRouteParametersApplied;
    private bool m_bShow_Product_Import;
    private bool m_bShow_Unit_Import;
    private bool m_bShow_Category_Import;
    private bool m_bShow_Supplier_Import;
    private bool m_bShow_Warehouse_Import;
    private bool m_bShow_Document_Import;
    private CWarehouseMaster m_objMaster = new();
    private CDM_Kho m_objKho = new();
    private CDM_Don_Vi_Tinh m_objDon_Vi_Tinh = new();
    private CDM_Loai_San_Pham m_objLoai_San_Pham = new();
    private CDM_San_Pham m_objSan_Pham = new();
    private CDM_NCC m_objNCC = new();
    private CWarehousePermission m_objPermission = new();
    private CWarehouseDocument m_objDocument = new();
    private CWarehouseDocument? m_objSelectedDocument;
    private CWarehouseDocumentDetail m_objDetail = new();
    private List<CWarehouseMaster> m_arrMaster = new();
    private List<CWarehouseDocument> m_arrDocument = new();
    private List<CWarehouseDocumentDetail> m_arrDetail = new();
    private List<CWarehouseLookup> m_arrUnit = new(), m_arrCategory = new(), m_arrProduct = new(), m_arrSupplier = new(), m_arrWarehouse = new(), m_arrAllWarehouse = new(), m_arrUser = new();
    private List<CWarehousePermission> m_arrWarehouseUser = new();
    private List<CWarehouseDetailReport> m_arrDetailReport = new();
    private List<CWarehouseInventoryReport> m_arrInventoryReport = new();
    private DateTime m_dtmFrom = new(DateTime.Today.Year, DateTime.Today.Month, 1), m_dtmTo = DateTime.Today;
    private long? m_iReport_Warehouse_ID;
    private long? m_iDocument_Warehouse_ID;
    private bool m_bDocumentEditing;
    private bool m_bDetailEditing;
    private bool Is_Receipt
    {
        get
        {
            return m_strSection == "Receipt";
        }
    }

    private bool Can_Import_Document =>
        (m_strSection is "Receipt" or "Issue") && r_objChuc_Nang.Is_Have_Add_Permission;

    private RenderFragment Document_Import_Tool_Item => @<button type="button" class="dropdown-item" @onclick="Open_Document_Import"><i class="ri-file-excel-2-fill align-bottom me-1"></i>&nbsp; Nhập Excel</button>;

    private bool Is_Current_Inventory_Report
    {
        get
        {
            return m_strReport_Type == "InventoryCurrent";
        }
    }
    private TelerikGrid<CWarehouseMaster> m_grdMaster = new();
    private TelerikGrid<CWarehouseMaster> m_objFormattedMasterGrid = new();
