@* 23/10/2026 - Codex: host chỉ định tuyến; loại bỏ CRUD danh mục trùng với các List/Info/Edit đang hoạt động. *@
@if (m_strSection == "Report")
{
    <FWarehouse_Report_List m_strInitial_Report_Type="@m_strInitial_Report_Type" />
}
else if (m_bWarehouse_Permission_Only || m_strInitial_Master_Type == "KhoUser")
{
    <FWarehouse_Permission_List />
}
else
{
    @switch (m_strInitial_Master_Type)
    {
        case "Kho": <F2009_1_Kho_List /> break;
        case "LoaiSanPham": <F2017_1_Loai_San_Pham_List /> break;
        case "SanPham": <F2018_1_San_Pham_List /> break;
        case "NCC": <F2019_1_Nha_Cung_Cap_List /> break;
        default: <FWarehouse_Unit_List /> break;
    }
}
@code {
    [Parameter] public string m_strSection { get; set; } = "Master";
    [Parameter] public string m_strInitial_Master_Type { get; set; } = "DonViTinh";
    [Parameter] public string m_strInitial_Report_Type { get; set; } = "Receipt";
    [Parameter] public bool m_bMaster_Type_Only { get; set; }
    [Parameter] public bool m_bWarehouse_Permission_Only { get; set; }
}
