    private void Edit_Master(CWarehouseMaster p_objData)
    {
        r_iAuto_ID = p_objData.Auto_ID;
        switch (m_strMaster_Type)
        {
            case "Kho":
                m_objKho = new CDM_Kho { Auto_ID = p_objData.Auto_ID, Ten_Kho = p_objData.Name, Ghi_Chu = p_objData.Ghi_Chu };
                break;
            case "DonViTinh":
                m_objDon_Vi_Tinh = new CDM_Don_Vi_Tinh { Auto_ID = p_objData.Auto_ID, Ten_Don_Vi_Tinh = p_objData.Name, Ghi_Chu = p_objData.Ghi_Chu };
                break;
            case "LoaiSanPham":
                m_objLoai_San_Pham = new CDM_Loai_San_Pham { Auto_ID = p_objData.Auto_ID, Ma_LSP = p_objData.Code, Ten_LSP = p_objData.Name, Ghi_Chu = p_objData.Ghi_Chu };
                break;
            case "SanPham":
                m_objSan_Pham = new CDM_San_Pham
                {
                    Auto_ID = p_objData.Auto_ID,
                    Ma_San_Pham = p_objData.Code,
                    Ten_San_Pham = p_objData.Name,
                    Loai_San_Pham_ID = p_objData.Related_ID,
                    Don_Vi_Tinh_ID = p_objData.Related_ID_2,
                    Ghi_Chu = p_objData.Ghi_Chu
                };
                break;
            case "NCC":
                m_objNCC = new CDM_NCC { Auto_ID = p_objData.Auto_ID, Ma_NCC = p_objData.Code, Ten_NCC = p_objData.Name, Ghi_Chu = p_objData.Ghi_Chu };
                break;
            default:
                throw new ArgumentException("Loại danh mục không hợp lệ.", nameof(m_strMaster_Type));
        }
        r_bIs_Show_Edit = true;
        Clear_Message();
    }

