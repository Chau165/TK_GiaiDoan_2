@using TKS_Thuc_Tap_V11_Web_Danh_Muc.Services
@using TKS_Thuc_Tap_V11_Data_Access.Controller.DM
@using TKS_Thuc_Tap_V11_Data_Access.Controller.Cache
@using TKS_Thuc_Tap_V11_Data_Access.Controller.BC
@using TKS_Thuc_Tap_V11_Data_Access.Utility
@using TKS_Thuc_Tap_V11_Data_Access.Entity.DM
@inherits FBase

<div class="card">
    @if (m_strSection == "Master")
    {
        <div class="card-header">
            <h5 class="mb-0">@Section_Title</h5>
        </div>
    }
    <div class="card-body">
        @((MarkupString)r_strError)
        @if (!String.IsNullOrWhiteSpace(m_strSuccess))
        {
            <div class="alert alert-success">@m_strSuccess</div>
        }
        @if (!String.IsNullOrWhiteSpace(m_strAuditWarning))
        {
            <div class="alert alert-warning">@m_strAuditWarning</div>
        }

        @if (m_strSection == "Master")
        {
            <div class="d-flex justify-content-between align-items-end gap-3">
                @if (!m_bMaster_Type_Only && !m_bWarehouse_Permission_Only)
                {
                    <div style="min-width: 280px;"><label class="form-label">@Get_Language_Data_Field("Loại danh mục")</label><select class="form-select" @bind="m_strMaster_Type" @bind:after="Load_Master_Async">
                        <option value="DonViTinh">@Get_Language_Data_Field("Đơn vị tính")</option>
                        <option value="LoaiSanPham">@Get_Language_Data_Field("Loại sản phẩm")</option>
                        <option value="SanPham">@Get_Language_Data_Field("Sản phẩm")</option>
                        <option value="NCC">@Get_Language_Data_Field("Nhà cung cấp")</option>
                        <option value="Kho">@Get_Language_Data_Field("Kho")</option>
                    </select></div>
                }
                <div class="d-flex gap-2 ms-auto">
                    @if (r_objChuc_Nang.Is_Have_Add_Permission)
                    {
                        <button type="button" class="btn btn-primary" @onclick="New_Master">@Get_Language_Data_Field("Thêm")</button>
                    }
                    @if (m_strMaster_Type == "KhoUser")
                    {
                        @Layout_Tool_Button(m_grdPermission)
                    }
                    else
                    {
                        @Layout_Tool_Button(m_grdMaster, Can_Import_Selected_Master ? Master_Import_Tool_Item : null, Export_Master_Excel_Async)
                    }
                </div>
            </div>
            <h5 class="mt-3">@Get_Language_Data_Field("Danh sách") @Master_Type_Title</h5>
            @if (m_strMaster_Type == "KhoUser")
            {
                <TelerikGrid TItem="CWarehousePermission" Height="calc(100vh - 310px)" Resizable="true" Reorderable="true" Pageable="true" PageSize="10" OnRead="Read_Kho_User_Async" @ref="m_grdPermission">
                    <GridExport><GridExcelExport FileName="Warehouse_Master_Export" AllPages="true" OnBeforeExport="Prepare_Excel_Export" /><GridCsvExport FileName="Warehouse_Master_Export" AllPages="true" /></GridExport>
                    <GridColumns>
                        <GridColumn Width="70px">
                            <Template>
                                <button type="button" class="btn btn-link" title='@Get_Language_Data_Field("Xem")' @onclick="@(() => Open_Kho_User_Info((context as CWarehousePermission)))">
                                    <i class="mdi mdi-eye" style="color: purple;"></i>
                                </button>
                                @if (r_objChuc_Nang.Is_Have_Edit_Permission || r_objChuc_Nang.Is_Have_Delete_Permission)
                                {
                                    <button type="button" class="btn btn-link" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="mdi mdi-cog-outline" style="color: purple;"></i>
                                    </button>
                                    <ul class="dropdown-menu">
                                        @if (r_objChuc_Nang.Is_Have_Edit_Permission)
                                        {
                                            <li><button class="dropdown-item" type="button" @onclick="@(() => Edit_Kho_User((context as CWarehousePermission)))"><i class="ri-edit-2-line align-bottom me-1"></i>&nbsp; @Get_Language_Data_Field("Hiệu chỉnh")</button></li>
                                        }
                                        @if (r_objChuc_Nang.Is_Have_Delete_Permission)
                                        {
                                            <li><button class="dropdown-item" type="button" @onclick="@(() => Delete_Kho_User_Async((context as CWarehousePermission).Permission_ID))"><i class="ri-delete-bin-line align-bottom me-1"></i>&nbsp; @Get_Language_Data_Field("Xóa")</button></li>
                                        }
                                    </ul>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="Login_Name" Title='@Get_Language_Data_Field("Mã đăng nhập")' Width="180px" ShowFilterCellButtons="false" /><GridColumn Field="User_Name" Title='@Get_Language_Data_Field("Họ tên")' Width="240px" ShowFilterCellButtons="false" /><GridColumn Field="Warehouse_Name" Title='@Get_Language_Data_Field("Tên kho")' ShowFilterCellButtons="false" />
                    </GridColumns>
                </TelerikGrid>
            }
            else
            {
                <TelerikGrid TItem="CWarehouseMaster" Height="calc(100vh - 310px)" Resizable="true" Reorderable="true" Pageable="true" PageSize="10" OnRead="Read_Master_Async" @ref="m_grdMaster">
                    <GridExport><GridExcelExport FileName="Warehouse_Master_Export" AllPages="true" OnBeforeExport="Prepare_Excel_Export" /><GridCsvExport FileName="Warehouse_Master_Export" AllPages="true" /></GridExport>
                    <GridColumns>
                        <GridColumn Width="70px">
                            <Template>
                                <button type="button" class="btn btn-link" title='@Get_Language_Data_Field("Xem")' @onclick="@(() => Open_Master_Info((context as CWarehouseMaster)))">
                                    <i class="mdi mdi-eye" style="color: purple;"></i>
                                </button>
                                @if (r_objChuc_Nang.Is_Have_Edit_Permission || r_objChuc_Nang.Is_Have_Delete_Permission)
                                {
                                    <button type="button" class="btn btn-link" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="mdi mdi-cog-outline" style="color: purple;"></i>
                                    </button>
                                    <ul class="dropdown-menu">
                                        @if (r_objChuc_Nang.Is_Have_Edit_Permission)
                                        {
                                            <li><button class="dropdown-item" type="button" @onclick="@(() => Edit_Master((context as CWarehouseMaster)))"><i class="ri-edit-2-line align-bottom me-1"></i>&nbsp; @Get_Language_Data_Field("Hiệu chỉnh")</button></li>
                                        }
                                        @if (r_objChuc_Nang.Is_Have_Delete_Permission)
                                        {
                                            <li><button class="dropdown-item" type="button" @onclick="@(() => Delete_Master_Async((context as CWarehouseMaster).Auto_ID))"><i class="ri-delete-bin-line align-bottom me-1"></i>&nbsp; @Get_Language_Data_Field("Xóa")</button></li>
                                        }
                                    </ul>
                                }
                            </Template>
                        </GridColumn>
                        @if (CCache_Grid_UI_Global.List_Data_By_Code("2010", "grdMaster").Count > 0)
                        {
                            <FCommon_General_Col_Grid m_strFCode="2010" m_strTen_Grid="grdMaster" />
                        }
                        else
                        {
                            <GridColumn Field="Code" Title='@Get_Language_Data_Field("Mã")' Width="140px" /><GridColumn Field="Name" Title='@Get_Language_Data_Field("Tên / đăng nhập")' Width="240px" /><GridColumn Field="Ghi_Chu" Title='@Get_Language_Data_Field("Ghi chú")' /><GridColumn Field="Related_ID" Title='@Get_Language_Data_Field("Liên kết")' Width="100px" />
                        }
                    </GridColumns>
                </TelerikGrid>
            }
        }

        @if (m_strSection == "Report")
        {
            @if (!Is_Current_Inventory_Report)
            {
                <ul class="nav nav-tabs mb-2" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button type="button" class="nav-link @(m_strReport_Type == "Receipt" ? "active" : "")" role="tab" @onclick="@(() => Select_Report_Type_Async("Receipt"))">@Get_Language_Data_Field("Chi tiết hàng nhập")</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button type="button" class="nav-link @(m_strReport_Type == "Issue" ? "active" : "")" role="tab" @onclick="@(() => Select_Report_Type_Async("Issue"))">@Get_Language_Data_Field("Chi tiết hàng xuất")</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button type="button" class="nav-link @(m_strReport_Type == "Inventory" ? "active" : "")" role="tab" @onclick="@(() => Select_Report_Type_Async("Inventory"))">@Get_Language_Data_Field("Xuất nhập tồn theo kỳ")</button>
                    </li>
                </ul>
            }

            @if (Is_Current_Inventory_Report)
            {
                <FWarehouse_Filter_Toolbar Localize="@Get_Language_Data_Field" ToolButtons="@Layout_Tool_Button(m_grdInventory)" />
            }
            else if (m_strReport_Type is "Inventory")
            {
                <FWarehouse_Filter_Toolbar
                    ShowDateRange="true"
                    DateLabel="Từ ngày"
                    DateFrom="@m_dtmFrom"
                    DateFromChanged="Set_Date_From"
                    DateTo="@m_dtmTo"
                    DateToChanged="Set_Date_To"
                    OnSearch="Load_Report_Async"
                    Localize="@Get_Language_Data_Field"
                    ToolButtons="@Layout_Tool_Button(m_grdInventory)" />
            }
            else
            {
                <FWarehouse_Filter_Toolbar
                    ShowDateRange="true"
                    DateLabel="Từ ngày"
                    DateFrom="@m_dtmFrom"
                    DateFromChanged="Set_Date_From"
                    DateTo="@m_dtmTo"
                    DateToChanged="Set_Date_To"
                    OnSearch="Load_Report_Async"
                    Localize="@Get_Language_Data_Field"
                    ToolButtons="@Layout_Tool_Button(m_grdReportDetail)" />
            }
            @if (m_strReport_Type is "Inventory" or "InventoryCurrent")
            {
                <TelerikGrid @key="m_strReport_Type" TItem="CWarehouseInventoryReport" Height="calc(100vh - 310px)" FilterMode="GridFilterMode.FilterRow" Resizable="true" Reorderable="true" Pageable="true" PageSize="10" OnRead="Read_Inventory_Async" @ref="m_grdInventory">
                    <GridExport>
                        <GridExcelExport FileName="Warehouse_Inventory_Export" AllPages="true" OnBeforeExport="Prepare_Excel_Export" />
                        <GridCsvExport FileName="Warehouse_Inventory_Export" AllPages="true" />
                    </GridExport>
                    <GridColumns>
                        <GridColumn Field="Ten_Kho" Title="Kho" />
                        <GridColumn Field="Ma_San_Pham" Title="Mã SP" />
                        <GridColumn Field="Ten_San_Pham" Title="Tên SP" />
                        @if (!Is_Current_Inventory_Report)
                        {
                            <GridColumn Field="SL_Dau_Ky" Title="SL đầu kỳ">
                                <Template Context="v_objContext">@(CUtility.Format_So_Luong(((CWarehouseInventoryReport)v_objContext).SL_Dau_Ky))</Template>
                            </GridColumn>
                            <GridColumn Field="SL_Nhap" Title="SL nhập">
                                <Template Context="v_objContext">@(CUtility.Format_So_Luong(((CWarehouseInventoryReport)v_objContext).SL_Nhap))</Template>
                            </GridColumn>
                            <GridColumn Field="SL_Xuat" Title="SL xuất">
                                <Template Context="v_objContext">@(CUtility.Format_So_Luong(((CWarehouseInventoryReport)v_objContext).SL_Xuat))</Template>
                            </GridColumn>
                            <GridColumn Field="SL_Cuoi_Ky" Title="SL cuối kỳ">
                                <Template Context="v_objContext">@(CUtility.Format_So_Luong(((CWarehouseInventoryReport)v_objContext).SL_Cuoi_Ky))</Template>
                            </GridColumn>
                        }
                        else
                        {
                            <GridColumn Field="SL_Ton_Thuc_Te" Title="Tồn thực tế">
                                <Template Context="v_objContext">@(CUtility.Format_So_Luong(((CWarehouseInventoryReport)v_objContext).SL_Ton_Thuc_Te))</Template>
                            </GridColumn>
                            <GridColumn Field="SL_Dang_Giu" Title="Đang giữ">
                                <Template Context="v_objContext">@(CUtility.Format_So_Luong(((CWarehouseInventoryReport)v_objContext).SL_Dang_Giu))</Template>
                            </GridColumn>
                            <GridColumn Field="SL_Kha_Dung" Title="Khả dụng">
                                <Template Context="v_objContext">@(CUtility.Format_So_Luong(((CWarehouseInventoryReport)v_objContext).SL_Kha_Dung))</Template>
                            </GridColumn>
                        }
                    </GridColumns>
                </TelerikGrid>
            }
            else
            {
                <TelerikGrid @key="m_strReport_Type" TItem="CWarehouseDetailReport" Height="calc(100vh - 310px)" FilterMode="GridFilterMode.FilterRow" Resizable="true" Reorderable="true" Pageable="true" PageSize="10" OnRead="Read_Report_Detail_Async" @ref="m_grdReportDetail">
                    <GridExport>
                        <GridExcelExport FileName="Warehouse_Report_Export" AllPages="true" OnBeforeExport="Prepare_Excel_Export" />
                        <GridCsvExport FileName="Warehouse_Report_Export" AllPages="true" />
                    </GridExport>
                    <GridColumns>
                        <GridColumn Field="Ngay" Title="Ngày" />
                        <GridColumn Field="So_Phieu" Title="Số phiếu" />
                        <GridColumn Field="Ten_Kho" Title="Kho" />
                        @if (m_strReport_Type == "Receipt")
                        {
                            <GridColumn Field="Nha_Cung_Cap" Title="NCC" />
                        }
                        <GridColumn Field="Ma_San_Pham" Title="Mã SP" />
                        <GridColumn Field="Ten_San_Pham" Title="Tên SP" />
                        <GridColumn Field="So_Luong" Title="SL"><Template Context="v_objContext">@(CUtility.Format_So_Luong(((CWarehouseDetailReport)v_objContext).So_Luong))</Template></GridColumn>
                        <GridColumn Field="Don_Gia" Title="Đơn giá"><Template Context="v_objContext">@(CUtility.Format_So_Tien(((CWarehouseDetailReport)v_objContext).Don_Gia))</Template></GridColumn>
                        <GridColumn Field="Tri_Gia" Title="Trị giá"><Template Context="v_objContext">@(CUtility.Format_So_Tien(((CWarehouseDetailReport)v_objContext).Tri_Gia))</Template></GridColumn>
                    </GridColumns>
                </TelerikGrid>
            }
        }
    </div>
</div>

@if (r_bIs_Show_Info)
{
    @if (m_strMaster_Type == "KhoUser")
    {
        <FWarehouse_2_Warehouse_Master_Info m_objPermission="@m_objPermission" m_strMaster_Type="@m_strMaster_Type" OnClose="@Close_Info" />
    }
    else
    {
        <FWarehouse_2_Warehouse_Master_Info m_objData="@m_objMaster" m_strMaster_Type="@m_strMaster_Type" OnClose="@Close_Info" />
    }
}

@if (r_bIs_Show_Edit)
{
    @if (m_strMaster_Type == "KhoUser")
    {
        <FWarehouse_3_Warehouse_Master_Edit m_strMaster_Type="@m_strMaster_Type" m_objPermission="@m_objPermission" m_arrUnit="@m_arrUnit" m_arrCategory="@m_arrCategory" m_arrWarehouse="@m_arrAllWarehouse" m_arrWarehouseUser="@m_arrWarehouseUser" m_arrUser="@m_arrUser" OnSave_Permission="Save_Kho_User_Async" OnClose="@Close_Edit" />
    }
    else
    {
        <FWarehouse_3_Warehouse_Master_Edit m_strMaster_Type="@m_strMaster_Type" m_objKho="@m_objKho" m_objDon_Vi_Tinh="@m_objDon_Vi_Tinh" m_objLoai_San_Pham="@m_objLoai_San_Pham" m_objSan_Pham="@m_objSan_Pham" m_objNCC="@m_objNCC" m_arrUnit="@m_arrUnit" m_arrCategory="@m_arrCategory" m_arrWarehouse="@m_arrAllWarehouse" m_arrUser="@m_arrUser" OnAdd_Kho="Add_Kho_Async" OnUpdate_Kho="Update_Kho_Async" OnAdd_Don_Vi_Tinh="Add_Don_Vi_Tinh_Async" OnUpdate_Don_Vi_Tinh="Update_Don_Vi_Tinh_Async" OnAdd_Loai_San_Pham="Add_Loai_San_Pham_Async" OnUpdate_Loai_San_Pham="Update_Loai_San_Pham_Async" OnAdd_San_Pham="Add_San_Pham_Async" OnUpdate_San_Pham="Update_San_Pham_Async" OnAdd_NCC="Add_NCC_Async" OnUpdate_NCC="Update_NCC_Async" OnClose="@Close_Edit" />
    }
}

@if (m_bShow_Product_Import)
{
    <FWarehouse_Product_Import UserName="@r_strActive_User_Name" FunctionCode="@r_strActive_Function_Code" Localize="@Get_Language_Data_Field" OnClose="Close_Product_Import" OnCompleted="On_Product_Import_Completed" />
}
@if (m_bShow_Category_Import)
{
    <FWarehouse_Category_Import UserName="@r_strActive_User_Name" FunctionCode="@r_strActive_Function_Code" Localize="@Get_Language_Data_Field" OnClose="Close_Category_Import" OnCompleted="On_Category_Import_Completed" />
}
@if (m_bShow_Supplier_Import)
{
    <FWarehouse_Supplier_Import UserName="@r_strActive_User_Name" FunctionCode="@r_strActive_Function_Code" Localize="@Get_Language_Data_Field" OnClose="Close_Supplier_Import" OnCompleted="On_Supplier_Import_Completed" />
}
@if (m_bShow_Warehouse_Import)
{
    <FWarehouse_Kho_Import UserName="@r_strActive_User_Name" FunctionCode="@r_strActive_Function_Code" Localize="@Get_Language_Data_Field" OnClose="Close_Warehouse_Import" OnCompleted="On_Warehouse_Import_Completed" />
}
@code {
    [Parameter] public string m_strSection { get; set; } = "Master";
    [Parameter] public string m_strInitial_Master_Type { get; set; } = "DonViTinh";
    [Parameter] public string m_strInitial_Report_Type { get; set; } = "Receipt";
    [Parameter] public bool m_bMaster_Type_Only { get; set; }
    [Parameter] public bool m_bWarehouse_Permission_Only { get; set; }

    private readonly CWarehouseMasterSupport_Controller m_objMasterSupportController = new();
    private readonly CDM_Kho_User_Controller m_objPermissionController = new();
    private readonly CWarehouseReport_Controller m_objReportController = new();
    private string m_strMaster_Type = "DonViTinh", m_strReport_Type = "Receipt", m_strSuccess = "", m_strAuditWarning = "";
    private bool m_bRouteParametersApplied;
    private bool m_bShow_Product_Import;
    private bool m_bShow_Category_Import;
    private bool m_bShow_Supplier_Import;
    private bool m_bShow_Warehouse_Import;
    private CWarehouseMaster m_objMaster = new();
    private CDM_Kho m_objKho = new();
    private CDM_Don_Vi_Tinh m_objDon_Vi_Tinh = new();
    private CDM_Loai_San_Pham m_objLoai_San_Pham = new();
    private CDM_San_Pham m_objSan_Pham = new();
    private CDM_NCC m_objNCC = new();
    private CWarehousePermission m_objPermission = new();
    private List<CWarehouseMaster> m_arrMaster = new();
    private List<CWarehouseLookup> m_arrUnit = new(), m_arrCategory = new(), m_arrProduct = new(), m_arrSupplier = new(), m_arrWarehouse = new(), m_arrAllWarehouse = new(), m_arrUser = new();
    private List<CWarehousePermission> m_arrWarehouseUser = new();
    private List<CWarehouseDetailReport> m_arrDetailReport = new();
    private List<CWarehouseInventoryReport> m_arrInventoryReport = new();
    private DateTime m_dtmFrom = new(DateTime.Today.Year, DateTime.Today.Month, 1), m_dtmTo = DateTime.Today;
    private bool Is_Current_Inventory_Report
    {
        get
        {
            return m_strReport_Type == "InventoryCurrent";
        }
    }
    private TelerikGrid<CWarehouseMaster> m_grdMaster = new();
    private TelerikGrid<CWarehouseMaster> m_objFormattedMasterGrid = new();
    private TelerikGrid<CWarehousePermission> m_grdPermission = new();
    private TelerikGrid<CWarehousePermission> m_objFormattedPermissionGrid = new();
    private string m_strFormattedMaster_Type = "";
    private TelerikGrid<CWarehouseDetailReport> m_grdReportDetail = new();
    private TelerikGrid<CWarehouseDetailReport>? m_objFormattedReportDetailGrid;
    private TelerikGrid<CWarehouseInventoryReport> m_grdInventory = new();
    private TelerikGrid<CWarehouseInventoryReport>? m_objFormattedInventoryGrid;

    private string Master_Type_Title
    {
        get
        {
            switch (m_strMaster_Type)
            {
                case "DonViTinh":
                    return Get_Language_Data_Field("Đơn vị tính");

                case "LoaiSanPham":
                    return Get_Language_Data_Field("Loại sản phẩm");

                case "SanPham":
                    return Get_Language_Data_Field("Sản phẩm");

                case "NCC":
                    return Get_Language_Data_Field("Nhà cung cấp");

                case "Kho":
                    return Get_Language_Data_Field("Kho");

                case "KhoUser":
                    return Get_Language_Data_Field("Phân quyền kho - user");

                default:
                    return Get_Language_Data_Field("Danh mục");
            }
        }
    }

    private string Section_Title
    {
        get
        {
            switch (m_strSection)
            {
                case "Master":
                    if (m_bWarehouse_Permission_Only)
                    {
                        return "Phân quyền kho - user";
                    }
                    else
                    {
                        return $"Master Data - {Master_Type_Title}";
                    }

                default:
                    if (Is_Current_Inventory_Report)
                    {
                        return "Tồn kho";
                    }
                    else
                    {
                        return "Báo cáo kho";
                    }
            }
        }
    }

    protected override void OnParametersSet()
    {
        if (!m_bRouteParametersApplied)
        {
            if (m_bWarehouse_Permission_Only)
            {
                m_strMaster_Type = "KhoUser";
            }
            else if (string.IsNullOrWhiteSpace(m_strInitial_Master_Type))
            {
                m_strMaster_Type = "DonViTinh";
            }
            else
            {
                m_strMaster_Type = m_strInitial_Master_Type;
            }

            if (string.IsNullOrWhiteSpace(m_strInitial_Report_Type))
            {
                m_strReport_Type = "Receipt";
            }
            else
            {
                m_strReport_Type = m_strInitial_Report_Type;
            }
            m_bRouteParametersApplied = true;
        }

        base.OnParametersSet();
    }

    protected override void Load_Data()
    {
        r_strError = "";
        m_strSuccess = "";
        m_strAuditWarning = "";
        if (m_strSection != "Master")
            return;

        if (m_strMaster_Type == "KhoUser")
        {
            Format_Grid(m_grdPermission);
            m_objFormattedPermissionGrid = m_grdPermission;
        }
        else
        {
            Format_Grid(m_grdMaster);
            m_objFormattedMasterGrid = m_grdMaster;
        }
    }

    protected override Task After_Render_Async(bool firstRender)
    {
        if (m_strSection == "Master" && m_strMaster_Type == "KhoUser" &&
            (!ReferenceEquals(m_objFormattedPermissionGrid, m_grdPermission) || m_strFormattedMaster_Type != m_strMaster_Type))
        {
            m_objFormattedPermissionGrid = m_grdPermission;
            m_strFormattedMaster_Type = m_strMaster_Type;
            Format_Grid(m_grdPermission);
        }
        else if (m_strSection == "Master" && m_strMaster_Type != "KhoUser" &&
            (!ReferenceEquals(m_objFormattedMasterGrid, m_grdMaster) || m_strFormattedMaster_Type != m_strMaster_Type))
        {
            m_objFormattedMasterGrid = m_grdMaster;
            m_strFormattedMaster_Type = m_strMaster_Type;
            Format_Grid(m_grdMaster);
        }

        if (m_strSection == "Report" && (m_strReport_Type is "Inventory" or "InventoryCurrent") &&
            !ReferenceEquals(m_objFormattedInventoryGrid, m_grdInventory))
        {
            m_objFormattedInventoryGrid = m_grdInventory;
            Format_Grid(m_grdInventory);
        }
        else if (m_strSection == "Report" && !Is_Current_Inventory_Report &&
            !ReferenceEquals(m_objFormattedReportDetailGrid, m_grdReportDetail))
        {
            m_objFormattedReportDetailGrid = m_grdReportDetail;
            Format_Grid(m_grdReportDetail);
        }

        return Task.CompletedTask;
    }

    protected override async Task Load_Data_Async()
    {
        await Load_Lookups_Async();
        if (m_strSection == "Master") await Load_Master_Async();
    }

    private async Task Load_Lookups_Async()
    {
        Load_Unit_Lookup();
        var v_dicUnitNamesByID = m_arrUnit.ToDictionary(v_objUnit => v_objUnit.Auto_ID, v_objUnit => v_objUnit.Name);
        m_arrCategory = new CDM_Loai_San_Pham_Controller().F2017_sp_sel_List_Loai_San_Pham_Lookup()
            .Select(v_objCategory => new CWarehouseLookup { Auto_ID = v_objCategory.Auto_ID, Code = v_objCategory.Ma_LSP, Name = v_objCategory.Ten_LSP })
            .ToList();
        m_arrProduct = new CDM_San_Pham_Controller().F2018_sp_sel_List_San_Pham()
            .Select(v_objProduct =>
            {
                v_dicUnitNamesByID.TryGetValue(v_objProduct.Don_Vi_Tinh_ID, out var v_strUnitName);
                var v_strDisplayName = string.IsNullOrWhiteSpace(v_strUnitName)
                    ? v_objProduct.Ten_San_Pham
                    : $"{v_objProduct.Ten_San_Pham} ({v_strUnitName})";

                return new CWarehouseLookup
                {
                    Auto_ID = v_objProduct.Auto_ID,
                    Code = v_objProduct.Ma_San_Pham,
                    Name = v_strDisplayName
                };
            })
            .ToList();
        m_arrSupplier = new CDM_NCC_Controller().F2019_sp_sel_List_NCC_Lookup()
            .Select(v_objSupplier => new CWarehouseLookup { Auto_ID = v_objSupplier.Auto_ID, Code = v_objSupplier.Ma_NCC, Name = v_objSupplier.Ten_NCC })
            .ToList();
        m_arrAllWarehouse = new CDM_Kho_Controller().F2009_sp_sel_List_Kho_Lookup()
            .Select(v_objWarehouse => new CWarehouseLookup { Auto_ID = v_objWarehouse.Auto_ID, Name = v_objWarehouse.Ten_Kho })
            .ToList();
        m_arrWarehouse = m_objPermissionController.sp_DM_Kho_User_List_Allowed(r_strActive_User_Name);
        m_arrUser = m_objPermissionController.F2015_sp_sel_List_Sys_Thanh_Vien_Cho_Phan_Quyen_Kho();
        m_arrWarehouseUser = m_objPermissionController.F2015_sp_sel_List_Kho_User()
            .Select(To_Permission_UI_Projection)
            .ToList();
    }

