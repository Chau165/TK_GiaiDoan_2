    private Task Read_Inventory_Async(GridReadEventArgs args)
    {
        try
        {
            if (CGrid_DataSource_Utility.Requires_Full_Source(args.Request, r_bIs_Excel_OnRead_Export))
            {
                List<CWarehouseInventoryReport> v_arrSource;
                if (Is_Current_Inventory_Report)
                {
                    var v_objFullResult = m_objReportController.F9001_sp_Ton_Kho_Hien_Tai_Page(
                        1, 0, r_strActive_User_Name, null);
                    v_arrSource = v_objFullResult.Items;
                }
                else
                {
                    v_arrSource = Get_Historical_Inventory_Report(
                        m_dtmFrom, m_dtmTo, r_strActive_User_Name, null);
                }

                var v_objReadResult = CGrid_DataSource_Utility.Apply(v_arrSource, args.Request);
                args.Data = v_objReadResult.Items; args.Total = v_objReadResult.Total_Count;
                if (args.Request.PageSize > 0)
                    m_arrInventoryReport = v_objReadResult.Items;
            }
            else
            {
                var v_iPage_Size = args.Request.PageSize;
                if (v_iPage_Size == 0 && !r_bIs_Excel_OnRead_Export)
                    v_iPage_Size = 10;

                var v_objResult = Is_Current_Inventory_Report
                    ? m_objReportController.F9001_sp_Ton_Kho_Hien_Tai_Page(
                        args.Request.Page, v_iPage_Size, r_strActive_User_Name, null)
                    : m_objReportController.F9002_sp_Xuat_Nhap_Ton_Page(
                        m_dtmFrom, m_dtmTo, args.Request.Page, v_iPage_Size, r_strActive_User_Name, null);
                m_arrInventoryReport = v_objResult.Items; args.Data = v_objResult.Items; args.Total = v_objResult.Total_Count;
            }
        }
        catch (Exception ex)
        {
            if (CWarehouseReportReadiness.IsRetryable(ex))
                Set_Report_Not_Ready();
            else
                Set_Error(ex);

            args.Data = new List<CWarehouseInventoryReport>(); args.Total = 0;
        }

        return Task.CompletedTask;
    }

    private List<CWarehouseInventoryReport> Get_Historical_Inventory_Report(
        DateTime p_dtmFrom,
        DateTime p_dtmTo,
        string p_strCurrent_Login,
        long? p_iWarehouse_ID)
    {
        List<CWarehouseInventoryReport> v_arrReport = m_objReportController.F9002_sp_Xuat_Nhap_Ton(
            p_dtmFrom, p_dtmTo, p_strCurrent_Login, p_iWarehouse_ID);
        Dictionary<long, string> v_dicAuthorizedWarehouseNames = m_objPermissionController
            .sp_DM_Kho_User_List_Allowed(p_strCurrent_Login)
            .ToDictionary(v_objWarehouse => v_objWarehouse.Auto_ID, v_objWarehouse => v_objWarehouse.Name);

        foreach (CWarehouseInventoryReport v_objReport in v_arrReport)
            v_objReport.Ten_Kho = v_dicAuthorizedWarehouseNames.GetValueOrDefault(v_objReport.Kho_ID, "");

        return v_arrReport;
    }

    private void Try_Record_Action_History(long p_iRef_ID, string p_strAction, string p_strContent)
    {
        CWarehouseActionHistory_Recorder.TryRecord(
            () => CCommon_Controller.FCommon_Insert_Action_History(
                p_iRef_ID, p_strAction, "Web", r_strActive_User_Name, r_strActive_Function_Code,
                r_objChuc_Nang.Ten_Chuc_Nang, p_strContent),
            p_objException =>
            {
                CLogger.Warning(
                    nameof(FWarehouse_1_Warehouse_List),
                    nameof(Try_Record_Action_History),
                    $"Ref_ID={p_iRef_ID}; Action={p_strAction}; {p_objException}");
                m_strAuditWarning = "Nghiệp vụ đã thành công nhưng chưa ghi được lịch sử thao tác.";
            });
    }

    private void Clear_Message()
    {
        r_strError = "";
        m_strSuccess = "";
        m_strAuditWarning = "";
    }

    private void Set_Success(string p_strText) { r_strError = ""; m_strSuccess = p_strText; }
    private void Set_Error(Exception p_objException)
    {
        m_strSuccess = "";
        m_strAuditWarning = "";
        r_strError = CCommonFunction.Set_Error_MessageBox(p_objException.Message);
    }

    private void Set_Report_Not_Ready()
    {
        m_strSuccess = "";
        m_strAuditWarning = "";
        r_strError = CCommonFunction.Set_Error_MessageBox(CWarehouseReportReadiness.RetryMessage);
    }

