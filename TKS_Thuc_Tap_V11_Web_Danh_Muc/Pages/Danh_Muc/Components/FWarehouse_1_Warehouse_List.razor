    private async Task Delete_Master_Async(long p_iAuto_ID)
    {
        if (!r_objChuc_Nang.Is_Have_Delete_Permission)
            return;

        bool v_bConfirmed;
        try
        {
            v_bConfirmed = await g_jsRuntime.InvokeAsync<bool>(
                "confirm",
                Get_Language_Data_Field("Bạn chắc chắn muốn xóa dòng dữ liệu này?"));
        }
        catch (Exception ex)
        {
            Set_Error(ex);
            return;
        }
        if (!v_bConfirmed)
            return;

        await Task.Delay(1);
        long v_iQueue_ID = 0;
        r_objLayout.Start_Loading();
        try
        {
            v_iQueue_ID = Process_Queue("Warehouse Master Delete - " + m_strMaster_Type);
            switch (m_strMaster_Type)
            {
                case "Kho":
                    new CDM_Kho_Controller().F2009_sp_del_Kho(p_iAuto_ID, r_strActive_User_Name, r_strActive_Function_Code);
                    CCache_Kho.Delete_Data(p_iAuto_ID);
                    break;
                case "DonViTinh":
                    new CDM_Don_Vi_Tinh_Controller().F2016_sp_del_Don_Vi_Tinh(p_iAuto_ID, r_strActive_User_Name, r_strActive_Function_Code);
                    CCache_Don_Vi_Tinh.Delete_Data(p_iAuto_ID);
                    break;
                case "LoaiSanPham":
                    new CDM_Loai_San_Pham_Controller().F2017_sp_del_Loai_San_Pham(p_iAuto_ID, r_strActive_User_Name, r_strActive_Function_Code);
                    CCache_Loai_San_Pham.Delete_Data(p_iAuto_ID);
                    break;
                case "SanPham":
                    new CDM_San_Pham_Controller().F2018_sp_del_San_Pham(p_iAuto_ID, r_strActive_User_Name, r_strActive_Function_Code);
                    CCache_San_Pham.Delete_Data(p_iAuto_ID);
                    break;
                case "NCC":
                    new CDM_NCC_Controller().F2019_sp_del_NCC(p_iAuto_ID, r_strActive_User_Name, r_strActive_Function_Code);
                    CCache_NCC.Delete_Data(p_iAuto_ID);
                    break;
                default:
                    throw new ArgumentException("Loại danh mục không hợp lệ.", nameof(m_strMaster_Type));
            }
            Try_Record_Action_History(p_iAuto_ID, "Xóa", "Warehouse " + m_strMaster_Type);
            await Load_Lookups_Async();
            await Load_Master_Async();
            Set_Success(Get_Language_Data_Field("Đã xóa danh mục."));
        }
        catch (Exception ex)
        {
            Set_Error(ex);
        }
        finally
        {
            if (v_iQueue_ID > 0)
                End_Queue(v_iQueue_ID);
            r_objLayout.Stop_Loading();
        }
    }

