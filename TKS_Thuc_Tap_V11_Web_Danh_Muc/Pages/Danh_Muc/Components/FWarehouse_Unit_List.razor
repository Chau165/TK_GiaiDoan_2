@inherits FBase
@using TKS_Thuc_Tap_V11_Web_Danh_Muc.Services
@Layout_Default_Filter(grdData, "Don_Vi_Tinh_Import_Template.xlsx")

<div class="row" style="padding-top: 10px;">
    <div class="col-lg-12">
        @((MarkupString)r_strError)

        <TelerikGrid Data="@v_arrData" Height="calc(100vh - 190px)" Resizable="true" Reorderable="true" Pageable="true" Sortable="true" @ref="@grdData">
            <GridExport>
                <GridExcelExport FileName="Don_Vi_Tinh_Export" AllPages="true" OnBeforeExport="@Prepare_Excel_Export" />
                <GridCsvExport FileName="Don_Vi_Tinh_Export" AllPages="true" />
            </GridExport>
            <GridColumns>
                <GridCheckboxColumn SelectAll="true" CheckBoxOnlySelection="true" Width="30px" />
                <GridColumn Width="70px">
                    <Template>
                        <button class="btn btn-link" title='@Get_Language_Data_Field("Xem")' @onclick="@(() => Open_Info((context as CDM_Don_Vi_Tinh).Auto_ID))">
                            <i class="mdi mdi-eye" style="color: purple;"></i>
                        </button>
                        @if (r_objChuc_Nang.Is_Have_Edit_Permission || r_objChuc_Nang.Is_Have_Delete_Permission)
                        {
                            <button class="btn btn-link" data-bs-toggle="dropdown" aria-expanded="false" title='@Get_Language_Data_Field("Thao tác")'>
                                <i class="mdi mdi-cog-outline" style="color: purple;"></i>
                            </button>
                            <ul class="dropdown-menu">
                                @if (r_objChuc_Nang.Is_Have_Edit_Permission)
                                {
                                    <li><button class="dropdown-item" type="button" @onclick="@(() => Open_Unit_Edit((context as CDM_Don_Vi_Tinh).Auto_ID))"><i class="ri-edit-2-line align-bottom me-1"></i>@Get_Language_Data_Field("Hiệu chỉnh")</button></li>
                                }
                                @if (r_objChuc_Nang.Is_Have_Delete_Permission)
                                {
                                    <li><button class="dropdown-item" type="button" @onclick="@(() => Delete_Unit_Async((context as CDM_Don_Vi_Tinh).Auto_ID))"><i class="ri-delete-bin-line align-bottom me-1"></i>@Get_Language_Data_Field("Xóa")</button></li>
                                }
                            </ul>
                        }
                    </Template>
                </GridColumn>
                @if (CCache_Grid_UI_Global.List_Data_By_Code(r_strActive_Function_Code, "grdData").Count > 0)
                {
                    <FCommon_General_Col_Grid m_strFCode="@r_strActive_Function_Code" m_strTen_Grid="grdData" />
                }
                else
                {
                    <GridColumn Field="Ten_Don_Vi_Tinh" Title='@Get_Language_Data_Field("Tên đơn vị tính")' Width="240px" />
                    <GridColumn Field="Ghi_Chu" Title='@Get_Language_Data_Field("Ghi chú")' />
                }
            </GridColumns>
        </TelerikGrid>
    </div>
</div>

@if (r_bIs_Show_Info)
{
    <FWarehouse_Unit_Info r_iAuto_ID="@r_iAuto_ID" OnClose="@Close_Info" />
}
@if (r_bIs_Show_Help_Guide)
{
    <FCommon_Help_Guide m_strFCode="@r_strActive_Function_Code" OnClose="@Close_Helpguide" />
}
@if (r_bIs_Show_Edit)
{
    <FWarehouse_Unit_Edit r_iAuto_ID="@r_iAuto_ID" OnClose="@Close_Edit" />
}
@if (r_bIs_Show_Import_Excel)
{
    <FCommon_Import_Excel r_objImport_Excel="@r_objImport_Excel" OnClose="@Close_Import_Excel" Localize="@Get_Language_Data_Field" />
}
@if (r_bIs_Show_Message_Info)
{
    <FCommon_Message_Info r_strMessage_Header="@r_strMessage_Header" r_strMessage_Info="@r_strMessage_Info" OnClose="@Close_Message_Info" />
}

@code {
    private List<CDM_Don_Vi_Tinh> v_arrData = new();
    private TelerikGrid<CDM_Don_Vi_Tinh> grdData = new();

    protected override void Load_Data()
    {
        Format_Grid(grdData);
        v_arrData = new CDM_Don_Vi_Tinh_Controller().F2016_sp_sel_List_Don_Vi_Tinh_By_Created(r_objFilter.Date_From, r_objFilter.Date_To);
    }

    protected override void Delete_Data_Entry(long p_iAuto_ID)
    {
        var v_objData = v_arrData.FirstOrDefault(v_objItem => v_objItem.Auto_ID == p_iAuto_ID)
            ?? CCache_Don_Vi_Tinh.Get_Data_By_ID(p_iAuto_ID);
        if (v_objData is null)
            throw new InvalidOperationException(Get_Language_Data_Field("Không tìm thấy đơn vị tính cần xóa."));

        r_strDelete_Key = v_objData.Ten_Don_Vi_Tinh;
        new CDM_Don_Vi_Tinh_Controller().F2016_sp_del_Don_Vi_Tinh(
            p_iAuto_ID,
            r_strActive_User_Name,
            r_strActive_Function_Code);
        CCache_Don_Vi_Tinh.Delete_Data(p_iAuto_ID);
    }

    protected override void Import_Excel_Entry(CExcel_Controller v_objCtrlExcel, ref int p_iCount_Success, ref int p_iCount_Error)
    {
        var v_objCtrData = new CDM_Don_Vi_Tinh_Controller();
        var v_sbError = new StringBuilder();
        var v_sbHistoryWarning = new StringBuilder();
        var v_sbSkipped = new StringBuilder();
        var v_iSkipped = 0;
        var v_iFailed = 0;

        try
        {
            var v_objWorksheet = CImportLegacyWorksheetAdapter.ToUnit(
                v_objCtrlExcel.Read_Profiled_Import_Sheet("Unit"));
            var v_objValidation = CUnitImportValidator.Preview(
                v_objWorksheet,
                v_objCtrData.F2016_sp_sel_List_Don_Vi_Tinh());
            var v_arrFileErrors = v_objValidation.Errors.Where(v_objError => v_objError.Row_Number <= 1).ToArray();
            if (v_arrFileErrors.Length > 0 || v_objValidation.Unsupported_Columns.Count > 0 ||
                v_objValidation.Unsupported_Capabilities.Count > 0)
            {
                var v_arrMessages = v_arrFileErrors.Select(v_objError => v_objError.Message)
                    .Concat(v_objValidation.Unsupported_Columns.Select(v_strColumn => $"Cột không được hỗ trợ: {v_strColumn}."))
                    .Concat(v_objValidation.Unsupported_Capabilities.Select(v_objIssue => v_objIssue.Message));
                throw new InvalidDataException(string.Join(Environment.NewLine, v_arrMessages));
            }

            if (v_objValidation.Rows.Count == 0)
                throw new InvalidDataException(Get_Language_Data_Field("File không có dòng dữ liệu đơn vị tính."));

            foreach (var v_objRow in v_objValidation.Rows)
            {
                if (v_objRow.Is_Skipped)
                {
                    v_iSkipped++;
                    v_sbSkipped.AppendLine(string.Format(
                        Get_Language_Data_Field("Dòng {0} đã có dữ liệu giống hệt trong hệ thống; đã bỏ qua."),
                        v_objRow.Row_Number));
                    continue;
                }

                if (!v_objRow.Is_Valid)
                {
                    v_iFailed++;
                    foreach (var v_objError in v_objRow.Errors)
                        v_sbError.AppendLine(Get_Language_Data_Field(v_objError.Message));
                    continue;
                }

                var v_objData = new CDM_Don_Vi_Tinh
                {
                    Ten_Don_Vi_Tinh = v_objRow.Ten_Don_Vi_Tinh,
                    Ghi_Chu = v_objRow.Ghi_Chu
                };

                try
                {
                    using (SqlConnection v_conn = CSqlHelper.CreateConnection(CConfig.TKS_Thuc_Tap_V11_Conn_String))
                    {
                        v_conn.Open();
                        using (SqlTransaction v_trans = v_conn.BeginTransaction())
                        {
                            try
                            {
                                v_objData.Auto_ID = v_objCtrData.F2016_sp_ins_Don_Vi_Tinh(
                                    v_conn,
                                    v_trans,
                                    v_objData,
                                    r_strActive_User_Name,
                                    r_strActive_Function_Code);
                                v_trans.Commit();
                            }
                            catch
                            {
                                try
                                {
                                    v_trans.Rollback();
                                }
                                catch
                                {
                                }
                                throw;
                            }
                        }
                    }

                    CCache_Don_Vi_Tinh.Add_Data(v_objData);
                    p_iCount_Success++;
                    try
                    {
                        CCommon_Controller.FCommon_Insert_Action_History(
                            v_objData.Auto_ID,
                            Get_Language_Data_Field("Import Excel - Thêm Mới"),
                            "Web",
                            r_strActive_User_Name,
                            r_strActive_Function_Code,
                            r_objChuc_Nang.Ten_Chuc_Nang,
                            "Key: " + v_objData.Ten_Don_Vi_Tinh);
                    }
                    catch (Exception p_objException)
                    {
                        v_sbHistoryWarning.AppendLine(string.Format(
                            Get_Language_Data_Field("Dòng {0} đã được nhập nhưng không ghi được lịch sử xử lý: {1}"),
                            v_objRow.Row_Number,
                            p_objException.Message));
                    }
                }
                catch (Exception p_objException)
                {
                    v_iFailed++;
                    v_sbError.AppendLine(string.Format(
                        Get_Language_Data_Field("Dòng {0} có lỗi: {1}"),
                        v_objRow.Row_Number,
                        p_objException.Message));
                }
            }

            p_iCount_Error = v_iFailed + v_iSkipped;

            var v_strMessage = CCommonFunction.Set_Success_MessageBox(string.Format(
                Get_Language_Data_Field("Thêm mới {0} dòng thành công."),
                p_iCount_Success));
            if (v_sbError.Length > 0)
                v_strMessage += CCommonFunction.Set_Error_MessageBox(v_sbError.ToString());
            if (v_sbSkipped.Length > 0)
                v_strMessage += CCommonFunction.Set_Error_MessageBox(v_sbSkipped.ToString());
            if (v_sbHistoryWarning.Length > 0)
                v_strMessage += CCommonFunction.Set_Error_MessageBox(v_sbHistoryWarning.ToString());

            Open_Message_Info(Get_Language_Data_Field("Thông báo Import Excel"), v_strMessage);
        }
        catch (Exception p_objException)
        {
            p_iCount_Error = Math.Max(p_iCount_Error, 1);
            Open_Message_Info(
                Get_Language_Data_Field("Thông báo Import Excel"),
                CCommonFunction.Set_Error_MessageBox(Get_Language_Data_Field(p_objException.Message)));
        }
    }

    private void Open_Unit_Edit(long p_iAuto_ID)
    {
        var v_blCanEdit = p_iAuto_ID == 0
            ? r_objChuc_Nang.Is_Have_Add_Permission
            : r_objChuc_Nang.Is_Have_Edit_Permission;
        if (!v_blCanEdit)
            return;

        Open_Edit(p_iAuto_ID);
    }

    private Task Delete_Unit_Async(long p_iAuto_ID)
    {
        if (!r_objChuc_Nang.Is_Have_Delete_Permission)
            return Task.CompletedTask;

        return Delete_Data(p_iAuto_ID);
    }
}
