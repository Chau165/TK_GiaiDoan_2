@using TKS_Thuc_Tap_V11_Data_Access.Entity.Warehouse
@using TKS_Thuc_Tap_V11_Web_Danh_Muc.Services

<div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" style="background-color: rgba(10, 10, 10, .8);">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title">Nhập Excel - Loại sản phẩm</h5>
                <button type="button" class="btn-close" aria-label="Đóng" disabled="@(m_eState == ECategoryImportState.Importing)" @onclick="Close_Async"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                    <a class="btn btn-outline-secondary" href="/FileManagement/Template/Loai_San_Pham_Import_Template.xlsx" download>
                        <i class="ri-download-2-line me-1"></i>Tải template
                    </a>
                    <div>
                        <label class="form-label" for="category-import-file">Chọn file .xlsx</label>
                        <InputFile id="category-import-file" OnChange="On_File_Changed" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" disabled="@(m_eState is ECategoryImportState.Parsing or ECategoryImportState.Importing)" />
                    </div>
                    <button type="button" class="btn btn-primary" @onclick="Preview_Async" disabled="@(!Can_Preview)">
                        @if (m_eState == ECategoryImportState.Parsing)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Đang kiểm tra</span>
                        }
                        else
                        {
                            <span>Xem trước</span>
                        }
                    </button>
                </div>
                <p class="small text-muted">Chỉ nhận .xlsx theo sheet LoaiSanPham với đúng cột Ma_LSP, Ten_LSP, Ghi_Chu; tối đa 1 MiB và 100 dòng dữ liệu.</p>
                @if (m_objFile is not null)
                {
                    <p class="small">File: @m_objFile.Name (@m_objFile.Size.ToString("N0") byte)</p>
                }
                @if (!string.IsNullOrWhiteSpace(m_strError))
                {
                    <div class="alert alert-danger" role="alert">@m_strError</div>
                }
                @if (m_eState == ECategoryImportState.Success)
                {
                    <div class="alert alert-success" role="status">@m_strSuccess</div>
                }
                @if (m_objPreview is not null)
                {
                    <div class="row g-3 mb-3" aria-live="polite">
                        <div class="col-6 col-lg-3"><strong>Tổng:</strong> @m_objPreview.Total_Rows</div>
                        <div class="col-6 col-lg-3"><strong>Hợp lệ:</strong> @m_objPreview.Valid_Rows</div>
                        <div class="col-6 col-lg-3"><strong>Bỏ qua:</strong> @m_objPreview.Skipped_Rows</div>
                        <div class="col-6 col-lg-3"><strong>Lỗi:</strong> @m_objPreview.Invalid_Rows</div>
                    </div>
                    @if (m_objPreview.Unsupported_Columns.Count > 0)
                    {
                        <div class="alert alert-warning py-2" role="alert">Không nhập các cột chưa hỗ trợ: @(string.Join(", ", m_objPreview.Unsupported_Columns)).</div>
                    }
                    <div class="small text-muted mb-2">
                        <div>Cột đã ánh xạ: @(string.Join(", ", m_objPreview.Mapped_Columns))</div>
                        <div>Cột bỏ qua: @(string.Join(", ", m_objPreview.Ignored_Columns))</div>
                    </div>
                    <FImportFieldPolicyDiagnostics Diagnostics="m_objPreview.Field_Policy_Diagnostics" />
                    @if (m_objPreview.Unsupported_Capabilities.Count > 0)
                    {
                        <div class="alert alert-danger py-2" role="alert">
                            <strong>Không thể xác nhận do giới hạn dữ liệu:</strong>
                            <ul class="mb-0">
                                @foreach (var v_objCapability in m_objPreview.Unsupported_Capabilities)
                                {
                                    <li>Dòng @v_objCapability.RowNumber, @v_objCapability.SourceColumn (@v_objCapability.SourceValue): @v_objCapability.Message</li>
                                }
                            </ul>
                        </div>
                    }
                    @foreach (var v_objError in m_objPreview.Errors.Where(v_objError => !m_objPreview.Rows.Any(v_objRow => v_objRow.Row_Number == v_objError.Row_Number)))
                    {
                        <div class="alert alert-danger py-2" role="alert">@v_objError.Message</div>
                    }
                    @if (m_objPreview.Rows.Count > 0)
                    {
                        <div class="table-responsive" style="max-height: 55vh;">
                            <table class="table table-sm table-bordered table-striped align-middle">
                                <thead class="table-light position-sticky top-0">
                                    <tr>
                                        <th scope="col">Dòng</th>
                                        <th scope="col">Ma_LSP</th>
                                        <th scope="col">Ten_LSP</th>
                                        <th scope="col">Ghi_Chu</th>
                                        <th scope="col">Trạng thái / lỗi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var v_objRow in m_objPreview.Rows)
                                    {
                                        <tr>
                                            <td>@v_objRow.Row_Number</td>
                                            <td>@v_objRow.Ma_LSP</td>
                                            <td>@v_objRow.Ten_LSP</td>
                                            <td>@v_objRow.Ghi_Chu</td>
                                            <td>
                            @if (v_objRow.Is_Skipped)
                            {
                                <span class="text-muted">Bỏ qua (trùng dữ liệu)</span>
                            }
                            else if (v_objRow.Is_Valid)
                                                {
                                                    <span class="text-success">Hợp lệ</span>
                                                }
                                                else
                                                {
                                                    <ul class="mb-0 ps-3">
                                                        @foreach (var v_objRowError in v_objRow.Errors)
                                                        {
                                                            <li>@v_objRowError.Message</li>
                                                        }
                                                    </ul>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" disabled="@(m_eState == ECategoryImportState.Importing)" @onclick="Close_Async">Đóng</button>
                <button type="button" class="btn btn-primary" disabled="@(!Can_Confirm)" @onclick="Confirm_Async">
                    @if (m_eState == ECategoryImportState.Importing)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Đang nhập</span>
                    }
                    else
                    {
                        <span>Xác nhận nhập</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private const long m_iMaxFileSize = 1_048_576;
    private readonly CWarehouseCategoryImportService m_objImportService = new();
    private IBrowserFile? m_objFile;
    private CCategoryImportPreviewResult? m_objPreview;
    private ECategoryImportState m_eState = ECategoryImportState.NoFile;
    private string m_strError = "";
    private string m_strSuccess = "";

    [Parameter] public string UserName { get; set; } = "";
    [Parameter] public string FunctionCode { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<int> OnCompleted { get; set; }

    private bool Can_Preview => m_objFile is not null &&
        string.Equals(Path.GetExtension(m_objFile.Name), ".xlsx", StringComparison.OrdinalIgnoreCase) &&
        m_objFile.Size <= m_iMaxFileSize &&
        m_eState is not ECategoryImportState.Parsing and not ECategoryImportState.Importing and not ECategoryImportState.Success;
    private bool Can_Confirm => m_objPreview?.Can_Confirm == true && m_eState == ECategoryImportState.PreviewValid;

    private void On_File_Changed(InputFileChangeEventArgs p_objArgs)
    {
        m_objFile = p_objArgs.File;
        m_objPreview = null;
        m_strError = "";
        m_strSuccess = "";
        m_eState = ECategoryImportState.NoFile;
        if (!string.Equals(Path.GetExtension(m_objFile.Name), ".xlsx", StringComparison.OrdinalIgnoreCase))
        {
            m_strError = "Chỉ chấp nhận file Excel .xlsx theo template Loại sản phẩm.";
            m_eState = ECategoryImportState.Failed;
        }
        else if (m_objFile.Size > m_iMaxFileSize)
        {
            m_strError = "File không được vượt quá 1 MiB.";
            m_eState = ECategoryImportState.Failed;
        }
    }

    private async Task Preview_Async()
    {
        if (m_objFile is null || !Can_Preview)
            return;
        m_eState = ECategoryImportState.Parsing;
        m_objPreview = null;
        m_strError = "";
        m_strSuccess = "";
        try
        {
            var v_arrContent = await FBase.Read_Import_File_Async(m_objFile, ".xlsx", m_iMaxFileSize);
            using var v_objStream = new MemoryStream(v_arrContent, writable: false);
            m_objPreview = await m_objImportService.PreviewAsync(m_objFile.Name, v_objStream, UserName, FunctionCode);
            m_eState = m_objPreview.Can_Confirm ? ECategoryImportState.PreviewValid : ECategoryImportState.PreviewInvalid;
        }
        catch (CCategoryImportValidationException p_objException)
        {
            m_objPreview = p_objException.PreviewResult;
            m_eState = ECategoryImportState.PreviewInvalid;
        }
        catch (Exception p_objException)
        {
            m_strError = p_objException.Message;
            m_eState = ECategoryImportState.Failed;
        }
    }

    private async Task Confirm_Async()
    {
        if (!Can_Confirm || m_objPreview is null)
            return;
        m_eState = ECategoryImportState.Importing;
        m_strError = "";
        try
        {
            var v_iRowCount = await m_objImportService.ConfirmAsync(m_objPreview, UserName, FunctionCode);
            m_eState = ECategoryImportState.Success;
            m_strSuccess = $"Đã nhập thành công {v_iRowCount} loại sản phẩm.";
            await OnCompleted.InvokeAsync(v_iRowCount);
        }
        catch (CCategoryImportValidationException p_objException)
        {
            m_objPreview = p_objException.PreviewResult;
            m_eState = ECategoryImportState.PreviewInvalid;
        }
        catch (Exception p_objException)
        {
            m_strError = p_objException.Message;
            m_eState = ECategoryImportState.Failed;
        }
    }

    private Task Close_Async() => OnClose.InvokeAsync();

    private enum ECategoryImportState
    {
        NoFile,
        Parsing,
        PreviewValid,
        PreviewInvalid,
        Importing,
        Success,
        Failed
    }
}
