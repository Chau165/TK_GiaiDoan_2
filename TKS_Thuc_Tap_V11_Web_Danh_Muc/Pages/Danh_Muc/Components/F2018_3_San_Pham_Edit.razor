@inherits FBase

<div class="modal fade show" tabindex="-1" role="dialog" aria-hidden="true" style="display: block; background-color: rgba(10, 10, 10, .8);">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title">@Get_Language_Data_Field(r_iAuto_ID == 0 ? "Thêm mới" : "Hiệu chỉnh")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label='@Get_Language_Data_Field("Đóng")' @onclick="@(() => Modal_Cancel())"></button>
            </div>
            @((MarkupString)r_strError)
            <EditForm Model="@m_objData">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="row mb-3"><div class="col-lg-11">
                                <label class="form-label">@Get_Language_Data_Field("Mã sản phẩm"):</label>
                                <InputText class="form-control" @bind-Value="m_objData.Ma_San_Pham" maxlength="100" />
                            </div></div>
                            <div class="row mb-3"><div class="col-lg-11">
                                <label class="form-label">@Get_Language_Data_Field("Tên sản phẩm"):</label>
                                <InputText class="form-control" @bind-Value="m_objData.Ten_San_Pham" maxlength="255" />
                            </div></div>
                        </div>
                        <div class="col-lg-6">
                            <div class="row mb-3"><div class="col-lg-11">
                                <label class="form-label">@Get_Language_Data_Field("Loại sản phẩm"):</label>
                                <TelerikDropDownList Data="@m_arrCategories" TItem="CDM_Loai_San_Pham" TValue="long" @bind-Value="m_objData.Loai_San_Pham_ID" ValueField="@nameof(CDM_Loai_San_Pham.Auto_ID)" TextField="@nameof(CDM_Loai_San_Pham.Ten_LSP)" DefaultText='@Get_Language_Data_Field("-- Chọn loại sản phẩm --")' />
                            </div></div>
                            <div class="row mb-3"><div class="col-lg-11">
                                <label class="form-label">@Get_Language_Data_Field("Đơn vị tính"):</label>
                                <TelerikDropDownList Data="@m_arrUnits" TItem="CDM_Don_Vi_Tinh" TValue="long" @bind-Value="m_objData.Don_Vi_Tinh_ID" ValueField="@nameof(CDM_Don_Vi_Tinh.Auto_ID)" TextField="@nameof(CDM_Don_Vi_Tinh.Ten_Don_Vi_Tinh)" DefaultText='@Get_Language_Data_Field("-- Chọn đơn vị tính --")' />
                            </div></div>
                            <div class="row mb-3"><div class="col-lg-11">
                                <label class="form-label">@Get_Language_Data_Field("Ghi chú"):</label>
                                <InputText class="form-control" @bind-Value="m_objData.Ghi_Chu" maxlength="1000" />
                            </div></div>
                        </div>
                    </div>
                </div>
            </EditForm>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" disabled="@(!Can_Save)" @onclick="Save_Product_Data">@Get_Language_Data_Field("Lưu Thay Đổi")</button>
            </div>
        </div>
    </div>
</div>

@code {
    private CDM_San_Pham m_objData = new();
    private List<CDM_Loai_San_Pham> m_arrCategories = new();
    private List<CDM_Don_Vi_Tinh> m_arrUnits = new();
    private bool Can_Save
    {
        get
        {
            if (r_iAuto_ID == 0)
            {
                return r_objChuc_Nang.Is_Have_Add_Permission;
            }
            else
            {
                return r_objChuc_Nang.Is_Have_Edit_Permission && m_objData.Auto_ID == r_iAuto_ID;
            }
        }
    }

    protected override void Load_Data()
    {
        r_bUpdate = false;
        r_objSource = null;
        r_objDes = null;
        r_strAdd_Key = "";
        m_objData = new CDM_San_Pham();
        m_arrCategories = new CDM_Loai_San_Pham_Controller().F2017_sp_sel_List_Loai_San_Pham_Lookup();
        m_arrUnits = new CDM_Don_Vi_Tinh_Controller().F2016_sp_sel_List_Don_Vi_Tinh_Lookup();
        if (r_iAuto_ID == 0)
        {
            return;
        }

        m_objData = new CDM_San_Pham_Controller().F2018_sp_sel_List_San_Pham().FirstOrDefault(v_objItem => v_objItem.Auto_ID == r_iAuto_ID) ?? throw new InvalidOperationException(Get_Language_Data_Field("Không tìm thấy sản phẩm cần hiệu chỉnh."));
        r_bUpdate = true;
        var v_objClone = new CDM_San_Pham();
        CUtility.Clone_Entity(m_objData, v_objClone);
        r_objSource = v_objClone;
    }

    protected override void Add_Data()
    {
        Check_Data();
        m_objData.Auto_ID = new CDM_San_Pham_Controller().F2018_sp_ins_San_Pham(m_objData, r_strActive_User_Name, r_strActive_Function_Code);
        r_iAuto_ID = m_objData.Auto_ID;
        r_strAdd_Key = m_objData.Ma_San_Pham;
        CCache_San_Pham.Add_Data(m_objData);
    }

    protected override void Update_Data()
    {
        Check_Data();
        new CDM_San_Pham_Controller().F2018_sp_upd_San_Pham(m_objData, r_strActive_User_Name, r_strActive_Function_Code);
        var v_objClone = new CDM_San_Pham();
        CUtility.Clone_Entity(m_objData, v_objClone);
        r_objDes = v_objClone;
        CCache_San_Pham.Update_Data(m_objData);
    }

    private void Check_Data()
    {
        r_strError = "";
        m_objData.Ma_San_Pham = m_objData.Ma_San_Pham?.Trim() ?? "";
        m_objData.Ten_San_Pham = m_objData.Ten_San_Pham?.Trim() ?? "";
        m_objData.Ghi_Chu = m_objData.Ghi_Chu?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(m_objData.Ma_San_Pham))
        {
            throw new InvalidOperationException(Get_Language_Data_Field("Mã sản phẩm không được để trống."));
        }

        if (m_objData.Ma_San_Pham.Length > 100)
        {
            throw new InvalidOperationException(Get_Language_Data_Field("Mã sản phẩm không được vượt quá 100 ký tự."));
        }

        if (string.IsNullOrWhiteSpace(m_objData.Ten_San_Pham))
        {
            throw new InvalidOperationException(Get_Language_Data_Field("Tên sản phẩm không được để trống."));
        }

        if (m_objData.Ten_San_Pham.Length > 255)
        {
            throw new InvalidOperationException(Get_Language_Data_Field("Tên sản phẩm không được vượt quá 255 ký tự."));
        }

        if (m_objData.Ghi_Chu.Length > 1000)
        {
            throw new InvalidOperationException(Get_Language_Data_Field("Ghi chú không được vượt quá 1000 ký tự."));
        }

        if (!m_arrCategories.Any(v_objItem => v_objItem.Auto_ID == m_objData.Loai_San_Pham_ID))
        {
            throw new InvalidOperationException(Get_Language_Data_Field("Loại sản phẩm không hợp lệ hoặc chưa được chọn."));
        }

        if (!m_arrUnits.Any(v_objItem => v_objItem.Auto_ID == m_objData.Don_Vi_Tinh_ID))
        {
            throw new InvalidOperationException(Get_Language_Data_Field("Đơn vị tính không hợp lệ hoặc chưa được chọn."));
        }

        var v_strCodeKey = CImportBusinessValueComparer.Normalize(m_objData.Ma_San_Pham).ToUpperInvariant();
        var v_arrExisting = new CDM_San_Pham_Controller().F2018_sp_sel_List_San_Pham();
        if (v_arrExisting.Any(v_objItem => v_objItem.Auto_ID != m_objData.Auto_ID && CImportBusinessValueComparer.Normalize(v_objItem.Ma_San_Pham).ToUpperInvariant() == v_strCodeKey))
        {
            throw new InvalidOperationException(Get_Language_Data_Field("Mã sản phẩm đã tồn tại."));
        }
    }

    private async Task Save_Product_Data()
    {
        if (!Can_Save)
        {
            return;
        }

        await Save_Data();
    }
}
