    // 23/10/2026 - Codex: gom mapping Header/Detail đang bị lặp, không thay SP hoặc filter ngày chứng từ.
    private List<CWarehouseDocument> Load_Document_Source()
    {
        List<CWarehouseDocument> v_arrResult = new List<CWarehouseDocument>();
        if (m_bIs_Receipt)
        {
            foreach (CXNK_Nhap_Kho v_objData in m_objNhapKhoController.F3001_sp_sel_List_Nhap_Kho(r_strActive_User_Name, null))
            {
                v_arrResult.Add(To_Warehouse_Document(v_objData));
            }
        }
        else
        {
            foreach (CXNK_Xuat_Kho v_objData in m_objXuatKhoController.F3002_sp_sel_List_Xuat_Kho(r_strActive_User_Name, null))
            {
                v_arrResult.Add(To_Warehouse_Document(v_objData));
            }
        }
        List<CWarehouseDocument> v_arrFiltered = new List<CWarehouseDocument>();
        foreach (CWarehouseDocument v_objData in v_arrResult)
        {
            if (v_objData.Ngay_Chung_Tu.Date >= m_dtmFrom.Date && v_objData.Ngay_Chung_Tu.Date <= m_dtmTo.Date)
            {
                v_arrFiltered.Add(v_objData);
            }
        }
        return v_arrFiltered;
    }
    private List<CWarehouseDocumentDetail> Load_Document_Details(long p_iDocument_ID)
    {
        List<CWarehouseDocumentDetail> v_arrResult = new List<CWarehouseDocumentDetail>();
        if (m_bIs_Receipt)
        {
            foreach (CXNK_Nhap_Kho_Detail v_objData in m_objNhapKhoController.F3001_sp_sel_List_Nhap_Kho_Detail(p_iDocument_ID, r_strActive_User_Name))
            {
                v_arrResult.Add(To_Warehouse_Detail(v_objData));
            }
        }
        else
        {
            foreach (CXNK_Xuat_Kho_Detail v_objData in m_objXuatKhoController.F3002_sp_sel_List_Xuat_Kho_Detail(p_iDocument_ID, r_strActive_User_Name))
            {
                v_arrResult.Add(To_Warehouse_Detail(v_objData));
            }
        }
        return v_arrResult;
    }

