@using TKS_Thuc_Tap_V11_Web_Danh_Muc.Services
@using TKS_Thuc_Tap_V11_Data_Access.Controller.DM
@using TKS_Thuc_Tap_V11_Data_Access.Controller.Cache
@using TKS_Thuc_Tap_V11_Data_Access.Utility
@using TKS_Thuc_Tap_V11_Data_Access.Controller.XNK
@using TKS_Thuc_Tap_V11_Data_Access.Entity.DM
@using TKS_Thuc_Tap_V11_Data_Access.Entity.XNK
@inherits FBase

<div class="row">
    <div class="col-lg-12">
        @if (!string.IsNullOrWhiteSpace(m_strSuccess))
        {
            <div class="alert alert-success">@m_strSuccess</div>
        }
        @if (!string.IsNullOrWhiteSpace(m_strAuditWarning))
        {
            <div class="alert alert-warning">@m_strAuditWarning</div>
        }

        <FWarehouse_Filter_Toolbar
            ShowDateRange="true"
            DateLabel="Ngày chứng từ"
            DateFrom="@m_dtmFrom"
            DateFromChanged="Set_Date_From"
            DateTo="@m_dtmTo"
            DateToChanged="Set_Date_To"
            OnSearch="Load_Documents_Async"
            OnAdd="New_Document_Async"
            OnImport="Open_Document_Import_Async"
            CanAdd="@r_objChuc_Nang.Is_Have_Add_Permission"
            Localize="@Get_Language_Data_Field"
            ToolButtons="@Layout_Tool_Button(m_grdDocument, p_objCustom_Excel_Export: Export_Document_Excel_Async)" />

        @if (m_bDocumentEditing)
        {
            @if (m_bIs_Receipt)
            {
                <F3001_3_Nhap_Kho_Edit m_arrProduct="@m_arrProduct" m_objDocument="@m_objDocument" m_arrDetail="@m_arrEditDetail" m_bSaving="@m_bSaving" m_arrSupplier="@m_arrSupplier" m_arrWarehouse="@m_arrWarehouse" m_strError_Message="@r_strError" OnSave_Document="Save_Document_Async" OnCancel="Cancel_Document" />
            }
            else
            {
                <F3002_3_Xuat_Kho_Edit m_objDocument="@m_objDocument" m_arrDetail="@m_arrEditDetail" m_bSaving="@m_bSaving" m_arrProduct="@m_arrProduct" m_arrWarehouse="@m_arrWarehouse" m_strError_Message="@r_strError" OnSave_Document="Save_Document_Async" OnCancel="Cancel_Document" />
            }
        }

        <div class="row" style="padding-top: 10px;">
            <div class="col-lg-12">
                <TelerikGrid TItem="CWarehouseDocument" Height="calc(100vh - 310px)" FilterMode="GridFilterMode.FilterRow" Resizable="true" Reorderable="true" Pageable="true" Sortable="true" PageSize="10" OnRead="Read_Document_Async" @ref="m_grdDocument">
                    <GridExport>
                        <GridExcelExport FileName="Warehouse_Document_Export" AllPages="true" OnBeforeExport="Prepare_Excel_Export" />
                        <GridCsvExport FileName="Warehouse_Document_Export" AllPages="true" />
                    </GridExport>
                    <GridColumns>
                        <GridCheckboxColumn SelectAll="true" CheckBoxOnlySelection="true" Width="30px"></GridCheckboxColumn>
                        <GridColumn Width="60px" Title="">
                            <Template Context="v_objContext">
                                @{ var v_objDocument = (CWarehouseDocument)v_objContext; }
                                <button type="button" class="btn btn-link me-2" aria-label='@Get_Language_Data_Field("Thông tin")' @onclick="@(() => Select_Document_Async(v_objDocument))"><i class="mdi mdi-eye" style="color: purple;"></i></button>
                                @if (r_objChuc_Nang.Is_Have_Edit_Permission || (r_objChuc_Nang.Is_Have_Delete_Permission && !v_objDocument.Is_Posted))
                                {
                                    <button type="button" class="btn btn-link" aria-label='@Get_Language_Data_Field("Thao tác")' data-bs-toggle="dropdown" aria-expanded="false"><i class="mdi mdi-cog-outline" style="color: purple;"></i></button>
                                    <ul class="dropdown-menu">
                                        @if (r_objChuc_Nang.Is_Have_Edit_Permission)
                                        {
                                            <li><button type="button" class="dropdown-item" @onclick="@(() => Edit_Document(v_objDocument))"><i class="ri-edit-2-line align-bottom me-1"></i>&nbsp; @Get_Language_Data_Field("Hiệu chỉnh")</button></li>
                                        }
                                        @if (r_objChuc_Nang.Is_Have_Delete_Permission && !v_objDocument.Is_Posted)
                                        {
                                            <li><button type="button" class="dropdown-item" @onclick="@(() => Delete_Document_Async(v_objDocument))"><i class="ri-delete-bin-line align-bottom me-1"></i>&nbsp; @Get_Language_Data_Field("Xóa")</button></li>
                                        }
                                    </ul>
                                }
                            </Template>
                        </GridColumn>
                        @if (CCache_Grid_UI_Global.List_Data_By_Code(r_strActive_Function_Code, "grdData").Count > 0)
                        {
                            <FCommon_General_Col_Grid m_strFCode="@r_strActive_Function_Code" m_strTen_Grid="grdData" m_strExclude_Field_Name="Is_Posted" />
                        }
                        else
                        {
                        <GridColumn Field="Ngay_Chung_Tu" Title="Ngày" Width="120px" />
                        <GridColumn Field="So_Phieu" Title="Số phiếu" Width="160px" />
                        <GridColumn Field="Ten_Kho" Title="Kho" Width="180px" />
                        @if (m_bIs_Receipt)
                        {
                            <GridColumn Field="Ten_NCC" Title="NCC" Width="180px" />
                        }
                        <GridColumn Field="Ghi_Chu" Title="Ghi chú" />
                        <GridColumn Field="" Title="" />
                        }
                    </GridColumns>
                </TelerikGrid>
            </div>
        </div>

    </div>
</div>

@if (r_bIs_Show_Info)
{
    @if (m_bIs_Receipt)
    {
        <F3001_2_Nhap_Kho_Info m_objDocument="@m_objSelectedDocument" m_arrDetail="@m_arrDetail" m_bCan_Export="@r_objChuc_Nang.Is_Have_Export_Permission" OnPrint="Print_Async" OnCancel="Close_Document_Info" />
    }
    else
    {
        <F3002_2_Xuat_Kho_Info m_objDocument="@m_objSelectedDocument" m_arrDetail="@m_arrDetail" m_bCan_Export="@r_objChuc_Nang.Is_Have_Export_Permission" OnPrint="Print_Async" OnCancel="Close_Document_Info" />
    }
}

@if (r_bIs_Show_Import_Excel)
{
    <FCommon_Import_Excel r_objImport_Excel="@r_objImport_Excel" OnClose="@Close_Import_Excel" Localize="@Get_Language_Data_Field" />
}
@if (r_bIs_Show_Message_Info)
{
    <FCommon_Message_Info r_strMessage_Header="@r_strMessage_Header" r_strMessage_Info="@r_strMessage_Info" OnClose="@Close_Message_Info" />
}
else if (!m_bDocumentEditing && !string.IsNullOrWhiteSpace(r_strError))
{
    <FCommon_Message_Info r_strMessage_Header='@Get_Language_Data_Field("Thông báo")' r_strMessage_Info="@r_strError" OnClose="@Clear_List_Error" />
}

@code {
    private void Clear_List_Error()
    {
        r_strError = string.Empty;
    }

    [Parameter]
    public bool m_bIs_Receipt { get; set; }

    private readonly CDM_Kho_User_Controller m_objPermissionController = new();
    private readonly CXNK_Nhap_Kho_Controller m_objNhapKhoController = new();
    private readonly CXNK_Xuat_Kho_Controller m_objXuatKhoController = new();
    private string m_strSuccess = "";
    private string m_strAuditWarning = "";
    private bool m_bDocumentEditing;
    private bool m_bSaving;
    private List<CWarehouseDocumentDetail> m_arrEditDetail = new();
    private readonly CXNK_Document_Controller m_objAggregateController = new();
    private CWarehouseDocument m_objDocument = new();
    private CWarehouseDocument? m_objSelectedDocument;
    private List<CWarehouseDocument> m_arrDocument = new();
    private List<CWarehouseDocumentDetail> m_arrDetail = new();
    private List<CWarehouseLookup> m_arrUnit = new();
    private List<CWarehouseLookup> m_arrProduct = new();
    private List<CWarehouseLookup> m_arrSupplier = new();
    private List<CWarehouseLookup> m_arrWarehouse = new();
    private DateTime m_dtmFrom = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime m_dtmTo = DateTime.Today;
    private TelerikGrid<CWarehouseDocument> m_grdDocument = new();
    private TelerikGrid<CWarehouseDocument>? m_objFormattedDocumentGrid;
    protected override void Init_Data()
    {
        m_bDocumentEditing = false;
    }

    protected override void Load_Data()
    {
        r_strError = "";
        m_strSuccess = "";
        m_strAuditWarning = "";
        // FBase.Import_Excel kết thúc bằng Load_Data_Init; Grid OnRead cần Rebind.
        if (m_objFormattedDocumentGrid != null)
        {
            m_grdDocument.Rebind();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!ReferenceEquals(m_objFormattedDocumentGrid, m_grdDocument))
        {
            m_objFormattedDocumentGrid = m_grdDocument;
            Format_Grid(m_grdDocument);
        }


    }

    protected override Task Load_Data_Async()
    {
        Load_Transaction_Lookups();
        return Task.CompletedTask;
    }

    private void Load_Transaction_Lookups()
    {
        // 23/10/2026 - Codex: lookup/map tường minh, giữ thứ tự và lỗi duplicate key của Dictionary.
        m_arrUnit = new List<CWarehouseLookup>();
        Dictionary<long, string> v_dicUnit_Names = new Dictionary<long, string>();
        foreach (CDM_Don_Vi_Tinh v_objUnit in new CDM_Don_Vi_Tinh_Controller().F2016_sp_sel_List_Don_Vi_Tinh_Lookup())
        {
            m_arrUnit.Add(new CWarehouseLookup { Auto_ID = v_objUnit.Auto_ID, Name = v_objUnit.Ten_Don_Vi_Tinh });
            v_dicUnit_Names.Add(v_objUnit.Auto_ID, v_objUnit.Ten_Don_Vi_Tinh);
        }
        m_arrProduct = new List<CWarehouseLookup>();
        foreach (CDM_San_Pham v_objProduct in new CDM_San_Pham_Controller().F2018_sp_sel_List_San_Pham())
        {
            v_dicUnit_Names.TryGetValue(v_objProduct.Don_Vi_Tinh_ID, out string v_strUnit_Name);
            string v_strDisplay_Name = v_objProduct.Ten_San_Pham;
            if (!string.IsNullOrWhiteSpace(v_strUnit_Name))
            {
                v_strDisplay_Name = $"{v_objProduct.Ten_San_Pham} ({v_strUnit_Name})";
            }
            m_arrProduct.Add(new CWarehouseLookup { Auto_ID = v_objProduct.Auto_ID, Code = v_objProduct.Ma_San_Pham, Name = v_objProduct.Ma_San_Pham + " — " + v_strDisplay_Name });
        }
        m_arrSupplier = new List<CWarehouseLookup>();
        foreach (CDM_NCC v_objSupplier in new CDM_NCC_Controller().F2019_sp_sel_List_NCC_Lookup())
        {
            m_arrSupplier.Add(new CWarehouseLookup { Auto_ID = v_objSupplier.Auto_ID, Code = v_objSupplier.Ma_NCC, Name = v_objSupplier.Ten_NCC });
        }
        m_arrWarehouse = m_objPermissionController.sp_DM_Kho_User_List_Allowed(r_strActive_User_Name);
    }

    private Task New_Document_Async()
    {
        if (!r_objChuc_Nang.Is_Have_Add_Permission) return Task.CompletedTask;
        m_objDocument = New_Document_Model();
        m_arrEditDetail = m_objDocument.Details;
        r_iAuto_ID = 0;
        r_bIs_Show_Edit = true;
        r_bIs_Show_Info = false;
        m_objSelectedDocument = null;
        m_arrDetail.Clear();
        m_bDocumentEditing = true;
        Clear_Message();
        return Task.CompletedTask;
    }

    private Task Open_Document_Import_Async()
    {
        if (!r_objChuc_Nang.Is_Have_Add_Permission)
        {
            return Task.CompletedTask;
        }

        Clear_Message();
        if (m_bIs_Receipt)
        {
            Open_Import_Excel("Nhap_Kho_Import_Template.xlsx");
        }
        else
        {
            Open_Import_Excel("Xuat_Kho_Import_Template.xlsx");
        }
        return Task.CompletedTask;
    }

    private CWarehouseDocument New_Document_Model()
    {
        return new()
        {
            Is_Receipt = m_bIs_Receipt,
            Ngay_Chung_Tu = DateTime.Today
        };
    }

    private Task Load_Documents_Async()
    {
        try
        {
            m_grdDocument.Rebind();
        }
        catch (Exception v_objException)
        {
            Set_Error(v_objException);
        }

        return Task.CompletedTask;
    }

    private void Set_Date_From(DateTime p_dtmValue)
    {
        m_dtmFrom = p_dtmValue;
    }

    private void Set_Date_To(DateTime p_dtmValue)
    {
        m_dtmTo = p_dtmValue;
    }

    private void Cancel_Document()
    {
        if (m_bSaving) return;
        m_bDocumentEditing = false;
        r_bIs_Show_Edit = false;
        m_arrEditDetail = new();
        m_objDocument = New_Document_Model();
        Clear_Message();
    }

    private void Edit_Document(CWarehouseDocument p_objData)
    {
        if (!r_objChuc_Nang.Is_Have_Edit_Permission) return;
        try
        {
            m_objDocument = m_objAggregateController.sp_XNK_Document_Edit_Get(m_bIs_Receipt, p_objData.Auto_ID, r_strActive_User_Name);
            m_arrEditDetail = m_objDocument.Details;
            r_iAuto_ID = m_objDocument.Auto_ID;
            r_objSource = Clone_Document(m_objDocument);
            r_bIs_Show_Info = false;
            r_bIs_Show_Edit = true;
            m_bDocumentEditing = true;
            Clear_Message();
        }
        catch (Exception v_objException) { Set_Error(v_objException); }
    }

    private async Task Delete_Document_Async(CWarehouseDocument p_objData)
    {
        if (m_bSaving || !r_objChuc_Nang.Is_Have_Delete_Permission || p_objData.Is_Posted) return;

        bool v_bConfirmed;
        try
        {
            v_bConfirmed = await g_jsRuntime.InvokeAsync<bool>("confirm", Get_Language_Data_Field("Bạn chắc chắn muốn xóa dòng dữ liệu này?"));
        }
        catch (Exception v_objException)
        {
            Set_Error(v_objException);
            return;
        }

        if (!v_bConfirmed) return;

        await Task.Delay(1);
        long v_iQueue_ID = 0;
        r_objLayout.Start_Loading();
        try
        {
            v_iQueue_ID = Process_Queue("Warehouse Document Delete");
            if (m_bIs_Receipt)
            {
                m_objNhapKhoController.F3001_sp_del_Nhap_Kho_Header(p_objData.Auto_ID, r_strActive_User_Name);
            }
            else
            {
                m_objXuatKhoController.F3002_sp_del_Xuat_Kho_Header(p_objData.Auto_ID, r_strActive_User_Name);
            }

            Try_Record_Action_History(p_objData.Auto_ID, Get_Language_Data_Field("Xóa"), "Key: " + p_objData.So_Phieu);
            m_grdDocument.Rebind();
            Set_Success(Get_Language_Data_Field("Đã xóa phiếu."));
        }
        catch (Exception v_objException)
        {
            Set_Error(v_objException);
        }
        finally
        {
            if (v_iQueue_ID > 0)
            {
                End_Queue(v_iQueue_ID);
            }

            r_objLayout.Stop_Loading();
        }
    }

    private async Task Save_Document_Async(CWarehouseDocument p_objData)
    {
        if (m_bSaving) return;
        bool v_bNew = p_objData.Auto_ID == 0;
        if (v_bNew ? !r_objChuc_Nang.Is_Have_Add_Permission : !r_objChuc_Nang.Is_Have_Edit_Permission) return;
        m_bSaving = true;
        long v_iQueue_ID = 0;
        r_objLayout.Start_Loading();
        try
        {
            await Task.Yield();
            v_iQueue_ID = Process_Queue("Warehouse Document Save Posted");
            p_objData.Is_Receipt = m_bIs_Receipt;
            p_objData.Details = m_arrEditDetail;
            m_objAggregateController.sp_XNK_Document_Save_Posted(p_objData, r_strActive_User_Name);
            r_iAuto_ID = p_objData.Auto_ID;
            r_strAdd_Key = p_objData.So_Phieu;
            r_objDes = Clone_Document(p_objData);
            string v_strLog = v_bNew ? "Key: " + r_strAdd_Key : CUtility.Compare_Entity(r_objSource, r_objDes);
            v_strLog += " | Revision: " + p_objData.Document_Version;
            Try_Record_Action_History(p_objData.Auto_ID, Get_Language_Data_Field(v_bNew ? "Thêm mới" : "Hiệu chỉnh"), v_strLog);
            m_bDocumentEditing = false;
            r_bIs_Show_Edit = false;
            m_grdDocument.Rebind();
            Set_Success(Get_Language_Data_Field("Đã lưu phiếu; tồn kho đã được cập nhật."));
        }
        catch (Exception v_objException) { Set_Error(v_objException); }
        finally
        {
            End_Queue(v_iQueue_ID);
            r_objLayout.Stop_Loading();
            m_bSaving = false;
        }
    }

    private Task Select_Document_Async(CWarehouseDocument p_objData)
    {
        try
        {
            m_objSelectedDocument = m_objAggregateController.sp_XNK_Document_Edit_Get(m_bIs_Receipt, p_objData.Auto_ID, r_strActive_User_Name);
            m_arrDetail = m_objSelectedDocument.Details;
            r_iAuto_ID = p_objData.Auto_ID;
            r_bIs_Show_Info = true;
            r_bIs_Show_Edit = false;
            m_bDocumentEditing = false;
        }
        catch (Exception v_objException) { Set_Error(v_objException); }
        return Task.CompletedTask;
    }

    private void Close_Document_Info()
    {
        r_bIs_Show_Info = false;
        m_objSelectedDocument = null;
    }

    private async Task Export_Document_Excel_Async()
    {
        var v_dtmStart = DateTime.Now;
        await Task.Delay(1);
        r_objLayout.Start_Loading();
        r_strError = "";
        long v_iQueue_ID = 0;
        try
        {
            v_iQueue_ID = Process_Queue("Export Warehouse Documents Excel");
            List<CWarehouseDocument> v_arrDocuments = Load_Document_Source();
            var v_objGridState = m_grdDocument.GetState();
            var v_objRequest = new DataSourceRequest
            {
                Page = 1,
                Skip = 0,
                PageSize = 0,
                Filters = v_objGridState.FilterDescriptors.ToList(),
                Sorts = v_objGridState.SortDescriptors.ToList()
            };
            v_arrDocuments = CGrid_DataSource_Utility.Apply(v_arrDocuments, v_objRequest).Items;
            var v_arrRows = CWarehouseDocumentExcelExporter.BuildRows(v_arrDocuments, Load_Document_Details);
            var v_arrWorkbook = CWarehouseDocumentExcelExporter.CreateWorkbook(v_arrRows, m_bIs_Receipt);
            var v_strFile_Name = "Warehouse_Document_Export_" + DateTime.Now.ToString("ddMMyyHHmmss") + ".xlsx";
            using (var v_objStream = new MemoryStream(v_arrWorkbook))
            using (var v_objStreamReference = new DotNetStreamReference(stream: v_objStream))
                await g_jsRuntime.InvokeVoidAsync("downloadFileFromStream", v_strFile_Name, v_objStreamReference);
            var v_objAccessLogController = new CLog_Nhat_Ky_Truy_Cap_Chuc_Nang_Controller();
            var v_objAccessLog = new CLog_Nhat_Ky_Truy_Cap_Chuc_Nang
            {
                Ma_Chuc_Nang = r_strActive_Function_Code,
                Ma_Dang_Nhap = r_strActive_User_Name,
                Ten_Chuc_Nang = r_objChuc_Nang.Ten_Chuc_Nang
            };
            var v_strFunctionName = Get_Language_Data_Field(v_objAccessLog.Ma_Chuc_Nang);
            if (v_strFunctionName == v_objAccessLog.Ma_Chuc_Nang)
            {
                v_strFunctionName = v_objAccessLog.Ten_Chuc_Nang;
            }

            v_objAccessLog.Ten_Chuc_Nang = v_strFunctionName + " - " + Get_Language_Data_Field("Export Excel");
            v_objAccessLogController.FQ_424_NKTCCN_sp_ins_Insert(v_objAccessLog);
        }
        catch (Exception v_objException)
        {
            Set_Error(v_objException);
        }
        finally
        {
            End_Queue(v_iQueue_ID);
        }

        r_objLayout.Stop_Loading();
        var v_tsElapsed = DateTime.Now - v_dtmStart;
        await g_jsRuntime.InvokeVoidAsync("Set_Speed_Label", v_tsElapsed.TotalSeconds.ToString("###,###0.##") + "s");
    }

    private Task Read_Document_Async(GridReadEventArgs p_objArgs)
    {
        try
        {
            if (m_dtmFrom.Date > m_dtmTo.Date)
            {
                Set_Error(new InvalidOperationException("Khoảng ngày chứng từ không hợp lệ."));
                p_objArgs.Data = new List<CWarehouseDocument>();
                p_objArgs.Total = 0;
                return Task.CompletedTask;
            }

            List<CWarehouseDocument> v_arrSource = Load_Document_Source();
            var v_objReadResult = CGrid_DataSource_Utility.Apply(v_arrSource, p_objArgs.Request);
            m_arrDocument = v_objReadResult.Items;
            p_objArgs.Data = v_objReadResult.Items;
            p_objArgs.Total = v_objReadResult.Total_Count;
        }
        catch (Exception v_objException)
        {
            Set_Error(v_objException);
            p_objArgs.Data = new List<CWarehouseDocument>();
            p_objArgs.Total = 0;
        }

        return Task.CompletedTask;
    }

    private Task Print_Async()
    {
        if (r_objChuc_Nang.Is_Have_Export_Permission)
        {
            return g_jsRuntime.InvokeVoidAsync("print").AsTask();
        }
        else
        {
            return Task.CompletedTask;
        }
    }

    private void Try_Record_Action_History(long p_iRef_ID, string p_strAction, string p_strContent)
    {
        CWarehouseActionHistory_Recorder.TryRecord(() => CCommon_Controller.FCommon_Insert_Action_History(p_iRef_ID, p_strAction, "Web", r_strActive_User_Name, r_strActive_Function_Code, r_objChuc_Nang.Ten_Chuc_Nang, p_strContent), p_objException =>
        {
            CLogger.Warning(nameof(FWarehouse_Transaction_List), nameof(Try_Record_Action_History), $"Ref_ID={p_iRef_ID}; Action={p_strAction}; {p_objException}");
            m_strAuditWarning = "Nghiệp vụ đã thành công nhưng chưa ghi được lịch sử thao tác.";
        });
    }

    private void Clear_Message()
    {
        r_strError = "";
        m_strSuccess = "";
        m_strAuditWarning = "";
    }

    private void Set_Success(string p_strText)
    {
        r_strError = "";
        m_strSuccess = p_strText;
    }

    private void Set_Error(Exception p_objException)
    {
        m_strSuccess = "";
        m_strAuditWarning = "";
        r_strError = CCommonFunction.Set_Error_MessageBox(p_objException.Message);
    }

    private static CWarehouseDocument Clone_Document(CWarehouseDocument p_objData)
    {
        return System.Text.Json.JsonSerializer.Deserialize<CWarehouseDocument>(System.Text.Json.JsonSerializer.Serialize(p_objData))!;
    }

    private static CWarehouseDocument To_Warehouse_Document(CXNK_Nhap_Kho p_objData)
    {
        return new()
        {
            Auto_ID = p_objData.Auto_ID,
            Is_Receipt = true,
            So_Phieu = p_objData.So_Phieu_Nhap_Kho,
            Kho_ID = p_objData.Kho_ID,
            Ten_Kho = p_objData.Ten_Kho,
            NCC_ID = p_objData.NCC_ID,
            Ten_NCC = p_objData.Ten_NCC,
            Ngay_Chung_Tu = p_objData.Ngay_Nhap_Kho,
            Is_Posted = p_objData.Is_Posted,
            Posted_At = p_objData.Posted_At,
            Ghi_Chu = p_objData.Ghi_Chu,
            Created = p_objData.Created,
            Created_By = p_objData.Created_By,
            Created_By_Function = p_objData.Created_By_Function,
            Last_Updated = p_objData.Last_Updated,
            Last_Updated_By = p_objData.Last_Updated_By,
            Last_Updated_By_Function = p_objData.Last_Updated_By_Function
        };
    }

    private static CWarehouseDocument To_Warehouse_Document(CXNK_Xuat_Kho p_objData)
    {
        return new()
        {
            Auto_ID = p_objData.Auto_ID,
            Is_Receipt = false,
