@using TKS_Thuc_Tap_V11_Data_Access.Entity.Warehouse
@using TKS_Thuc_Tap_V11_Web_Danh_Muc.Services

<div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" style="background-color: rgba(10, 10, 10, .8);">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title">Nhập Excel - @Document_Type</h5>
                <button type="button" class="btn-close" aria-label="Đóng" disabled="@Is_Busy" @onclick="Close_Async"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                    <div>
                        <label class="form-label" for="transaction-import-file">Chọn file .xlsx</label>
                        <InputFile id="transaction-import-file" OnChange="On_File_Changed" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" disabled="@Is_Busy" />
                    </div>
                    <button type="button" class="btn btn-primary" @onclick="Preview_Async" disabled="@(!Can_Preview)">
                        @if (m_eState == EImportState.Previewing)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Đang kiểm tra</span>
                        }
                        else
                        {
                            <span>Xem trước</span>
                        }
                    </button>
                </div>
                <p class="small text-muted">Tối đa 25 MiB. Cột Đơn giá phải có giá trị lớn hơn 0; giá không được tự lấy từ danh mục hoặc tồn kho.</p>
                @if (m_objFile is not null)
                {
                    <p class="small">File: @m_objFile.Name (@m_objFile.Size.ToString("N0") byte)</p>
                }
                @if (!string.IsNullOrWhiteSpace(m_strError))
                {
                    <div class="alert alert-danger" role="alert">@m_strError</div>
                }
                @if (!string.IsNullOrWhiteSpace(m_strSuccess))
                {
                    <div class="alert alert-success" role="status">@m_strSuccess</div>
                }
                @if (m_objPreview is not null)
                {
                    <div class="row g-3 mb-3" aria-live="polite">
                        <div class="col-6 col-lg-3"><strong>Chứng từ:</strong> @m_objPreview.Documents.Count</div>
                        <div class="col-6 col-lg-3"><strong>Dòng hàng:</strong> @m_objPreview.Documents.Sum(v_objDocument => v_objDocument.Lines.Count)</div>
                        <div class="col-6 col-lg-3"><strong>Lỗi:</strong> @m_objPreview.Errors.Count</div>
                        <div class="col-6 col-lg-3"><strong>Có thể xác nhận:</strong> @(m_objPreview.Can_Confirm ? "Có" : "Không")</div>
                    </div>
                    @if (m_objPreview.Unsupported_Columns.Count > 0)
                    {
                        <div class="alert alert-warning py-2" role="alert">Workbook có cột chưa hỗ trợ: @string.Join(", ", m_objPreview.Unsupported_Columns)</div>
                    }
                    @if (m_objPreview.Mapped_Columns.Count > 0 || m_objPreview.Ignored_Columns.Count > 0)
                    {
                        <div class="small text-muted mb-2">
                            @if (m_objPreview.Mapped_Columns.Count > 0)
                            {
                                <div>Cột đã ánh xạ: @string.Join(", ", m_objPreview.Mapped_Columns)</div>
                            }
                            @if (m_objPreview.Ignored_Columns.Count > 0)
                            {
                                <div>Cột chỉ để tham khảo: @string.Join(", ", m_objPreview.Ignored_Columns)</div>
                            }
                        </div>
                    }
                    <FImportFieldPolicyDiagnostics Diagnostics="m_objPreview.Field_Policy_Diagnostics" />
                    @if (m_objPreview.Errors.Count > 0)
                    {
                        <div class="alert alert-danger py-2" role="alert">
                            <strong>Không thể xác nhận:</strong>
                            <ul class="mb-0">
                                @foreach (var v_objError in m_objPreview.Errors)
                                {
                                    <li>@Error_Location(v_objError): @v_objError.Message</li>
                                }
                            </ul>
                        </div>
                    }
                    @foreach (var v_objDocument in m_objPreview.Documents)
                    {
                        <section class="border rounded p-2 mb-3">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                                <div>
                                    <strong>@Document_Type @v_objDocument.DocumentNumber</strong>
                                    <div class="small text-muted">
                                        @v_objDocument.DocumentDate?.ToString("dd/MM/yyyy") · @v_objDocument.WarehouseName (@v_objDocument.WarehouseCode)
                                        @if (IsReceipt)
                                        {
                                            <span> · @v_objDocument.SupplierName (@v_objDocument.SupplierCode)</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(v_objDocument.Note))
                                    {
                                        <div class="small">@v_objDocument.Note</div>
                                    }
                                </div>
                                <span class="badge @Document_Status_Class(v_objDocument)">@Document_Status(v_objDocument)</span>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered table-striped align-middle mb-0">
                                    <thead class="table-light">
                                        <tr><th>Hàng hóa</th><th>ĐVT danh mục</th><th class="text-end">Số lượng</th><th class="text-end">Đơn giá</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var v_objLine in v_objDocument.Lines)
                                        {
                                            <tr>
                                                <td>@v_objLine.ProductCode · @v_objLine.ProductName</td>
                                                <td>@v_objLine.UnitReference</td>
                                                <td class="text-end">@v_objLine.Quantity?.ToString("N3")</td>
                                                <td class="text-end">@v_objLine.UnitPrice?.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </section>
                    }
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" disabled="@Is_Busy" @onclick="Close_Async">Đóng</button>
                <button type="button" class="btn btn-primary" disabled="@(!Can_Confirm)" @onclick="Confirm_Async">
                    @if (m_eState == EImportState.Confirming)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Đang nhập</span>
                    }
                    else
                    {
                        <span>Xác nhận nhập</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private const long m_iMaxFileSize = 25 * 1024 * 1024;
    private readonly CWarehouseTransactionImportService m_objImportService = new();
    private IBrowserFile? m_objFile;
    private byte[]? m_arrFileContent;
    private CTransactionImportPreviewResult? m_objPreview;
    private EImportState m_eState = EImportState.NoFile;
    private string m_strError = "";
    private string m_strSuccess = "";

    [Parameter] public bool IsReceipt { get; set; }
    [Parameter] public string UserName { get; set; } = "";
    [Parameter] public string FunctionCode { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<CTransactionImportConfirmResult> OnCompleted { get; set; }

    private bool Is_Busy => m_eState is EImportState.Previewing or EImportState.Confirming;
    private string Document_Type => IsReceipt ? "Phiếu nhập" : "Phiếu xuất";
    private string Profile_Code => IsReceipt ? "Inbound" : "Outbound";
    private bool Can_Preview => m_objFile is not null &&
        string.Equals(Path.GetExtension(m_objFile.Name), ".xlsx", StringComparison.OrdinalIgnoreCase) &&
        m_objFile.Size <= m_iMaxFileSize && !Is_Busy;
    private bool Can_Confirm => m_objPreview?.Can_Confirm == true &&
        m_arrFileContent is not null && m_eState == EImportState.Previewed;

    private void On_File_Changed(InputFileChangeEventArgs p_objArgs)
    {
        m_objFile = p_objArgs.File;
        m_arrFileContent = null;
        m_objPreview = null;
        m_strError = "";
        m_strSuccess = "";
        m_eState = EImportState.NoFile;

        if (!string.Equals(Path.GetExtension(m_objFile.Name), ".xlsx", StringComparison.OrdinalIgnoreCase))
        {
            m_strError = "Chỉ chấp nhận file Excel .xlsx.";
            m_eState = EImportState.Failed;
        }
        else if (m_objFile.Size > m_iMaxFileSize)
        {
            m_strError = "File không được vượt quá 25 MiB.";
            m_eState = EImportState.Failed;
        }
    }

    private async Task Preview_Async()
    {
        if (!Can_Preview || m_objFile is null)
            return;

        m_eState = EImportState.Previewing;
        m_objPreview = null;
        m_strError = "";
        m_strSuccess = "";
        try
        {
            m_arrFileContent = await FBase.Read_Import_File_Async(m_objFile, ".xlsx", m_iMaxFileSize);
            m_objPreview = await m_objImportService.PreviewAsync(
                m_objFile.Name, m_arrFileContent, Profile_Code, UserName, FunctionCode);
            m_eState = EImportState.Previewed;
        }
        catch (CTransactionImportValidationException p_objException)
        {
            m_objPreview = p_objException.PreviewResult;
            m_eState = EImportState.Previewed;
        }
        catch (Exception p_objException)
        {
            m_strError = p_objException.Message;
            m_eState = EImportState.Failed;
        }
    }

    private async Task Confirm_Async()
    {
        if (!Can_Confirm || m_objFile is null || m_arrFileContent is null)
            return;

        m_eState = EImportState.Confirming;
        m_strError = "";
        try
        {
            var v_objResult = await m_objImportService.ConfirmAsync(
                m_objFile.Name, m_arrFileContent, Profile_Code, UserName, FunctionCode);
            m_eState = EImportState.Completed;
            m_strSuccess = $"Đã nhập {v_objResult.Imported_Documents} chứng từ; bỏ qua {v_objResult.Skipped_Documents} chứng từ trùng khớp.";
            await OnCompleted.InvokeAsync(v_objResult);
        }
        catch (CTransactionImportValidationException p_objException)
        {
            m_objPreview = p_objException.PreviewResult;
            m_eState = EImportState.Previewed;
        }
        catch (Exception p_objException)
        {
            m_strError = p_objException.Message;
            m_eState = EImportState.Failed;
        }
    }

    private string Document_Status(CTransactionImportPreviewDocument p_objDocument)
    {
        if (Is_Document_Invalid(p_objDocument))
            return "Có lỗi";
        return p_objDocument.Import_Status == "SKIPPED_DUPLICATE_DOCUMENT" ? "Đã tồn tại, bỏ qua" : "Sẵn sàng";
    }

    private string Document_Status_Class(CTransactionImportPreviewDocument p_objDocument)
    {
        if (Is_Document_Invalid(p_objDocument))
            return "text-bg-danger";
        return p_objDocument.Import_Status == "SKIPPED_DUPLICATE_DOCUMENT" ? "text-bg-secondary" : "text-bg-success";
    }

    private bool Is_Document_Invalid(CTransactionImportPreviewDocument p_objDocument) =>
        m_objPreview?.Errors.Any(v_objError =>
            string.Equals(v_objError.DocumentNumber, p_objDocument.DocumentNumber, StringComparison.OrdinalIgnoreCase)) == true;

    private static string Error_Location(CTransactionImportIssue p_objError)
    {
        var v_strDocument = string.IsNullOrWhiteSpace(p_objError.DocumentNumber)
            ? "Workbook"
            : $"Chứng từ {p_objError.DocumentNumber}";
        return p_objError.RowNumber.HasValue
            ? $"{v_strDocument}, dòng {p_objError.RowNumber.Value}"
            : v_strDocument;
    }

    private Task Close_Async() => OnClose.InvokeAsync();

    private enum EImportState
    {
        NoFile,
        Previewing,
        Previewed,
        Confirming,
        Completed,
        Failed
    }
}
