@inherits FBase_Info

<div class="modal fade show" tabindex="-1" role="dialog" aria-hidden="true" style="display: block; padding-left: 0px; background-color: rgba(10, 10, 10, .8);">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <ul class="nav nav-pills card-header-pills" role="tablist">
                    <li class="nav-item" role="presentation">
                        <a class="nav-link active" data-bs-toggle="tab" href="#warehouse_master_info" role="tab" aria-selected="true">@Get_Language_Data_Field("Thông tin")</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" data-bs-toggle="tab" href="#warehouse_master_history" role="tab" aria-selected="false" tabindex="-1">@Get_Language_Data_Field("Lịch sử xử lý")</a>
                    </li>
                </ul>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Get_Language_Data_Field("Đóng")" @onclick="@(() => Modal_Cancel())"></button>
            </div>

            <div class="modal-body">
                <div class="tab-content">
                    <div class="tab-pane active show" id="warehouse_master_info" role="tabpanel">
                        @if (m_strMaster_Type == "KhoUser")
                        {
                            <div class="row g-3">
                                <div class="col-lg-4">
                                    <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("ID phân quyền")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objPermission.Permission_ID, true)</span></div>
                                    <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Mã đăng nhập")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objPermission.Login_Name, false)</span></div>
                                    <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Họ tên")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objPermission.User_Name, false)</span></div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("ID kho")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objPermission.Warehouse_ID, true)</span></div>
                                    <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Tên kho")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objPermission.Warehouse_Name, false)</span></div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row g-3">
                                <div class="col-lg-4">
                                    <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("ID")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Auto_ID, true)</span></div>
                                    @if (m_strMaster_Type is "LoaiSanPham" or "SanPham" or "NCC")
                                    {
                                        <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Mã")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Code, false)</span></div>
                                    }
                                    <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Tên")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Name, false)</span></div>
                                    @if (m_strMaster_Type == "SanPham")
                                    {
                                        <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Loại sản phẩm ID")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Related_ID, true)</span></div>
                                    }
                                </div>
                                <div class="col-lg-4">
                                    @if (m_strMaster_Type == "SanPham")
                                    {
                                        <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Đơn vị tính ID")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Related_ID_2, true)</span></div>
                                    }
                                    <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Ghi chú")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Ghi_Chu, false)</span></div>
                                </div>
                            </div>
                            <div class="row g-3 mt-1">
                                <div class="col-lg-4">
                                    <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Người tạo")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Created_By, false)</span></div>
                                    <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Chức năng tạo")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Created_By_Function, false)</span></div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Ngày cập nhật sau cùng")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Last_Updated, false)</span></div>
                                    <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Người cập nhật sau cùng")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Last_Updated_By, false)</span></div>
                                    <div class="mb-3"><label class="form-label-info">@Get_Language_Data_Field("Chức năng cập nhật sau cùng")</label><br /><span class="form-label">@CUtility.Get_Label_Text(m_objData.Last_Updated_By_Function, false)</span></div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="tab-pane" id="warehouse_master_history" role="tabpanel">
                        <FCommon_Record_Action_History_List v_arrData="@m_arrAction_History" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public CWarehouseMaster m_objData { get; set; } = new();
    [Parameter] public CWarehousePermission m_objPermission { get; set; } = new();
    [Parameter] public string m_strMaster_Type { get; set; } = "";
    private List<CLog_Record_Action_History> m_arrAction_History = new();

    protected override void Load_Data()
    {
        long v_iReference_ID;
        if (m_strMaster_Type == "KhoUser")
        {
            v_iReference_ID = m_objPermission.Permission_ID;
        }
        else
        {
            v_iReference_ID = m_objData.Auto_ID;
        }

        m_arrAction_History = new CLog_Record_Action_History_Controller().FCommon_Sys_sp_sel_List_Log_Record_Action_History(v_iReference_ID);
    }
}
