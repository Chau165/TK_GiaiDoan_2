@page "/Kho/Quan_Ly"
@inject IJSRuntime JS

<PageTitle>Quản lý kho</PageTitle>

<div class="card">
    <div class="card-header d-flex gap-2 flex-wrap">
        <button class="btn @(m_strSection == "Master" ? "btn-primary" : "btn-light")" @onclick="@(() => Select_Section("Master"))">Danh mục</button>
        <button class="btn @(m_strSection == "Receipt" ? "btn-primary" : "btn-light")" @onclick="@(() => Select_Section("Receipt"))">Phiếu nhập</button>
        <button class="btn @(m_strSection == "Issue" ? "btn-primary" : "btn-light")" @onclick="@(() => Select_Section("Issue"))">Phiếu xuất</button>
        <button class="btn @(m_strSection == "Report" ? "btn-primary" : "btn-light")" @onclick="@(() => Select_Section("Report"))">Báo cáo</button>
    </div>
    <div class="card-body">
        @if (!String.IsNullOrWhiteSpace(m_strError))
        {
            <div class="alert alert-danger">@m_strError</div>
        }
        @if (!String.IsNullOrWhiteSpace(m_strSuccess))
        {
            <div class="alert alert-success">@m_strSuccess</div>
        }

        @if (m_strSection == "Master")
        {
            <div class="row g-3">
                <div class="col-lg-4">
                    <label class="form-label">Loại danh mục</label>
                    <select class="form-select" @bind="m_strMasterType" @bind:after="Load_Master_Async">
                        <option value="DonViTinh">Đơn vị tính</option>
                        <option value="LoaiSanPham">Loại sản phẩm</option>
                        <option value="SanPham">Sản phẩm</option>
                        <option value="NCC">Nhà cung cấp</option>
                        <option value="Kho">Kho</option>
                        <option value="KhoUser">Phân quyền kho - user</option>
                    </select>
                </div>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-3">
                <h5 class="mb-0">Danh sách @((m_strMasterType == "KhoUser") ? "phân quyền kho - user" : "danh mục")</h5>
                <button type="button" class="btn btn-primary" @onclick="New_Master">Thêm</button>
            </div>
            @if (m_bMasterEditing)
            {
            <EditForm Model="m_objMaster" OnValidSubmit="Save_Master_Async">
                <DataAnnotationsValidator />
                <div class="row g-3 align-items-end">
                    @if (Need_Code())
                    {
                        <div class="col-md-3"><label class="form-label">Mã</label><InputText class="form-control" @bind-Value="m_objMaster.Code" /></div>
                    }
                    @if (m_strMasterType == "KhoUser")
                    {
                        <div class="col-md-4"><label class="form-label">Mã đăng nhập</label><InputText class="form-control" @bind-Value="m_objMaster.Login_Name" /></div>
                        <div class="col-md-4"><label class="form-label">Kho</label><select class="form-select" @bind="m_objMaster.Related_ID"><option value="0">-- Chọn kho --</option>@foreach (var item in m_arrWarehouse) { <option value="@item.Auto_ID">@item.Name</option> }</select></div>
                    }
                    else
                    {
                        <div class="col-md-4"><label class="form-label">Tên</label><InputText class="form-control" @bind-Value="m_objMaster.Name" /></div>
                    }
                    @if (m_strMasterType == "SanPham")
                    {
                        <div class="col-md-3"><label class="form-label">Loại sản phẩm</label><select class="form-select" @bind="m_objMaster.Related_ID"><option value="0">-- Chọn loại --</option>@foreach (var item in m_arrCategory) { <option value="@item.Auto_ID">@item.Code - @item.Name</option> }</select></div>
                        <div class="col-md-3"><label class="form-label">Đơn vị tính</label><select class="form-select" @bind="m_objMaster.Related_ID_2"><option value="0">-- Chọn đơn vị --</option>@foreach (var item in m_arrUnit) { <option value="@item.Auto_ID">@item.Name</option> }</select></div>
                    }
                    @if (m_strMasterType != "KhoUser")
                    {
                        <div class="col-md-4"><label class="form-label">Ghi chú</label><InputText class="form-control" @bind-Value="m_objMaster.Ghi_Chu" /></div>
                    }
                    <div class="col-md-2 d-flex gap-2"><button type="submit" class="btn btn-success">@(m_objMaster.Auto_ID == 0 ? "Thêm" : "Lưu")</button><button type="button" class="btn btn-light" @onclick="Reset_Master">Hủy</button></div>
                </div>
            </EditForm>
            }
            <div class="table-responsive mt-4"><table class="table table-sm table-hover"><thead><tr><th>Mã</th><th>Tên / đăng nhập</th><th>Ghi chú</th><th></th></tr></thead><tbody>
                @if (m_arrMaster.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted">Chưa có dữ liệu.</td></tr>
                }
                @foreach (var item in m_arrMaster)
                {
                    <tr><td>@item.Code</td><td>@(m_strMasterType == "KhoUser" ? item.Login_Name : item.Name)</td><td>@item.Ghi_Chu</td><td class="text-end"><button class="btn btn-sm btn-outline-primary me-1" @onclick="@(() => Edit_Master(item))">Sửa</button><button class="btn btn-sm btn-outline-danger" @onclick="@(() => Delete_Master_Async(item.Auto_ID))">Xóa</button></td></tr>
                }
            </tbody></table></div>
        }

        @if (m_strSection is "Receipt" or "Issue")
        {
            <div class="d-flex justify-content-between align-items-center mb-3"><h5 class="mb-0">@(Is_Receipt ? "Quản lý phiếu nhập" : "Quản lý phiếu xuất")</h5><button class="btn btn-outline-secondary" @onclick="New_Document">Tạo phiếu mới</button></div>
            @if (m_bDocumentEditing)
            {
            <EditForm Model="m_objDocument" OnValidSubmit="Save_Document_Async"><DataAnnotationsValidator />
                <div class="row g-3 align-items-end">
                    <div class="col-md-3"><label class="form-label">Số phiếu</label><InputText class="form-control" @bind-Value="m_objDocument.So_Phieu" /></div>
                    <div class="col-md-3"><label class="form-label">Kho</label><select class="form-select" @bind="m_objDocument.Kho_ID"><option value="0">-- Chọn kho --</option>@foreach(var item in m_arrWarehouse){<option value="@item.Auto_ID">@item.Name</option>}</select></div>
                    @if (Is_Receipt) { <div class="col-md-3"><label class="form-label">Nhà cung cấp</label><select class="form-select" @bind="m_objDocument.NCC_ID"><option value="0">-- Chọn NCC --</option>@foreach(var item in m_arrSupplier){<option value="@item.Auto_ID">@item.Code - @item.Name</option>}</select></div> }
                    <div class="col-md-2"><label class="form-label">Ngày</label><InputDate class="form-control" @bind-Value="m_objDocument.Ngay_Chung_Tu" /></div>
                    <div class="col-md-4"><label class="form-label">Ghi chú</label><InputText class="form-control" @bind-Value="m_objDocument.Ghi_Chu" /></div>
                    <div class="col-md-3 d-flex gap-2"><button class="btn btn-success" type="submit">@(m_objDocument.Auto_ID == 0 ? "Lưu phiếu" : "Cập nhật")</button><button class="btn btn-light" type="button" @onclick="Cancel_Document">Hủy</button></div>
                </div>
            </EditForm>
            }
            <div class="table-responsive mt-4"><table class="table table-sm table-hover"><thead><tr><th>Ngày</th><th>Số phiếu</th><th>Kho</th>@if(Is_Receipt){<th>NCC</th>}<th>Ghi chú</th><th></th></tr></thead><tbody>
                @if (m_arrDocument.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted">Chưa có phiếu.</td></tr>
                }
                @foreach(var item in m_arrDocument){<tr><td>@item.Ngay_Chung_Tu.ToString("dd/MM/yyyy")</td><td>@item.So_Phieu</td><td>@item.Ten_Kho</td>@if(Is_Receipt){<td>@item.Ten_NCC</td>}<td>@item.Ghi_Chu</td><td class="text-end"><button class="btn btn-sm btn-outline-primary me-1" @onclick="@(() => Select_Document_Async(item))">Chi tiết</button><button class="btn btn-sm btn-outline-secondary me-1" @onclick="@(() => Edit_Document(item))">Sửa</button><button class="btn btn-sm btn-outline-danger" @onclick="@(() => Delete_Document_Async(item.Auto_ID))">Xóa</button></td></tr>}
            </tbody></table></div>

            @if (m_objSelectedDocument != null)
            {
                <hr /><div id="warehouse-print"><div class="d-flex justify-content-between align-items-center"><h5>@(Is_Receipt ? "PHIẾU NHẬP KHO" : "PHIẾU XUẤT KHO") - @m_objSelectedDocument.So_Phieu</h5><button type="button" class="btn btn-primary no-print" @onclick="New_Detail">Thêm sản phẩm</button></div><p>Ngày: @m_objSelectedDocument.Ngay_Chung_Tu.ToString("dd/MM/yyyy") | Kho: @m_objSelectedDocument.Ten_Kho @if(Is_Receipt){<text>| NCC: @m_objSelectedDocument.Ten_NCC</text>}</p>
                @if (m_bDetailEditing)
                {
                    <EditForm Model="m_objDetail" OnValidSubmit="Save_Detail_Async"><DataAnnotationsValidator /><div class="row g-3 align-items-end"><div class="col-md-4"><label class="form-label">Sản phẩm</label><select class="form-select" @bind="m_objDetail.San_Pham_ID" disabled="@(m_objDetail.Auto_ID != 0)"><option value="0">-- Chọn sản phẩm --</option>@foreach(var item in m_arrProduct){<option value="@item.Auto_ID">@item.Code - @item.Name</option>}</select></div><div class="col-md-2"><label class="form-label">Số lượng</label><InputNumber class="form-control" @bind-Value="m_objDetail.So_Luong" step="0.001" /></div><div class="col-md-2"><label class="form-label">Đơn giá</label><InputNumber class="form-control" @bind-Value="m_objDetail.Don_Gia" step="0.01" /></div><div class="col-md-3"><label class="form-label">Trị giá</label><input class="form-control" value="@m_objDetail.Tri_Gia" disabled /></div><div class="col-md-1 d-flex gap-2"><button class="btn btn-success" type="submit">Lưu</button><button class="btn btn-light" type="button" @onclick="Cancel_Detail">Hủy</button></div></div></EditForm>
                }
                <table class="table table-bordered table-sm mt-3"><thead><tr><th>Mã</th><th>Tên sản phẩm</th><th class="text-end">SL</th><th class="text-end">Đơn giá</th><th class="text-end">Trị giá</th><th></th></tr></thead><tbody>@if(m_arrDetail.Count == 0){<tr><td colspan="6" class="text-center text-muted">Chưa có sản phẩm.</td></tr>}@foreach(var item in m_arrDetail){<tr><td>@item.Ma_San_Pham</td><td>@item.Ten_San_Pham</td><td class="text-end">@item.So_Luong</td><td class="text-end">@item.Don_Gia</td><td class="text-end">@item.Tri_Gia</td><td class="text-end"><button type="button" class="btn btn-sm btn-outline-primary me-1" @onclick="@(() => Edit_Detail(item))">Sửa</button><button type="button" class="btn btn-sm btn-outline-danger" @onclick="@(() => Delete_Detail_Async(item.Auto_ID))">Xóa</button></td></tr>}</tbody><tfoot><tr><th colspan="4" class="text-end">Tổng trị giá</th><th class="text-end">@m_arrDetail.Sum(x => x.Tri_Gia)</th><th></th></tr></tfoot></table>
                <button class="btn btn-primary no-print" @onclick="Print_Async">In phiếu</button></div>
            }
        }

        @if (m_strSection == "Report")
        {
            <div class="row g-3 align-items-end"><div class="col-md-3"><label class="form-label">Báo cáo</label><select class="form-select" @bind="m_strReportType"><option value="Receipt">Chi tiết hàng nhập</option><option value="Issue">Chi tiết hàng xuất</option><option value="Inventory">Xuất nhập tồn</option></select></div><div class="col-md-3"><label class="form-label">Từ ngày</label><InputDate class="form-control" @bind-Value="m_dtmFrom" /></div><div class="col-md-3"><label class="form-label">Đến ngày</label><InputDate class="form-control" @bind-Value="m_dtmTo" /></div><div class="col-md-2"><button class="btn btn-primary" @onclick="Load_Report_Async">Xem báo cáo</button></div></div>
            @if (m_strReportType == "Inventory") { <div class="table-responsive mt-4"><table class="table table-sm table-bordered"><thead><tr><th>Kho</th><th>Mã SP</th><th>Tên SP</th><th>SL đầu kỳ</th><th>SL nhập</th><th>SL xuất</th><th>SL cuối kỳ</th></tr></thead><tbody>@foreach(var item in m_arrInventoryReport){<tr><td>@item.Ten_Kho</td><td>@item.Ma_San_Pham</td><td>@item.Ten_San_Pham</td><td>@item.SL_Dau_Ky</td><td>@item.SL_Nhap</td><td>@item.SL_Xuat</td><td>@item.SL_Cuoi_Ky</td></tr>}</tbody></table></div> }
            else { <div class="table-responsive mt-4"><table class="table table-sm table-bordered"><thead><tr><th>Ngày</th><th>Số phiếu</th>@if(m_strReportType == "Receipt"){<th>NCC</th>}<th>Mã SP</th><th>Tên SP</th><th>SL</th><th>Đơn giá</th><th>Trị giá</th></tr></thead><tbody>@foreach(var item in m_arrDetailReport){<tr><td>@item.Ngay.ToString("dd/MM/yyyy")</td><td>@item.So_Phieu</td>@if(m_strReportType == "Receipt"){<td>@item.Nha_Cung_Cap</td>}<td>@item.Ma_San_Pham</td><td>@item.Ten_San_Pham</td><td>@item.So_Luong</td><td>@item.Don_Gia</td><td>@item.Tri_Gia</td></tr>}</tbody></table></div> }
        }
    </div>
</div>

@code {
    private readonly CWarehouse_Controller m_objController = new();
    private string m_strSection = "Master", m_strMasterType = "DonViTinh", m_strReportType = "Receipt", m_strError = "", m_strSuccess = "";
    private CWarehouseMaster m_objMaster = new();
    private CWarehouseDocument m_objDocument = new();
    private CWarehouseDocument? m_objSelectedDocument;
    private CWarehouseDocumentDetail m_objDetail = new();
    private List<CWarehouseMaster> m_arrMaster = new();
    private List<CWarehouseDocument> m_arrDocument = new();
    private List<CWarehouseDocumentDetail> m_arrDetail = new();
    private List<CWarehouseLookup> m_arrUnit = new(), m_arrCategory = new(), m_arrProduct = new(), m_arrSupplier = new(), m_arrWarehouse = new();
    private List<CWarehouseDetailReport> m_arrDetailReport = new();
    private List<CWarehouseInventoryReport> m_arrInventoryReport = new();
    private DateTime m_dtmFrom = new(DateTime.Today.Year, DateTime.Today.Month, 1), m_dtmTo = DateTime.Today;
    private bool m_bMasterEditing;
    private bool m_bDocumentEditing;
    private bool m_bDetailEditing;
    private bool Is_Receipt => m_strSection == "Receipt";

    protected override async Task OnInitializedAsync() { await Load_Lookups_Async(); await Load_Master_Async(); }
    private bool Need_Code() => m_strMasterType is "LoaiSanPham" or "SanPham" or "NCC";
    private async Task Select_Section(string value) { m_strSection=value; Clear_Message(); m_bMasterEditing=false; m_bDocumentEditing=false; m_bDetailEditing=false; m_objSelectedDocument=null; m_arrDetail.Clear(); if(value=="Master") await Load_Master_Async(); else if(value is "Receipt" or "Issue") { m_objDocument=new(){Is_Receipt=Is_Receipt,Ngay_Chung_Tu=DateTime.Today}; await Load_Documents_Async(); } }
    private async Task Load_Lookups_Async() { m_arrUnit=await m_objController.List_Lookup_Async("DonViTinh"); m_arrCategory=await m_objController.List_Lookup_Async("LoaiSanPham"); m_arrProduct=await m_objController.List_Lookup_Async("SanPham"); m_arrSupplier=await m_objController.List_Lookup_Async("NCC"); m_arrWarehouse=await m_objController.List_Lookup_Async("Kho"); }
    private async Task Load_Master_Async() { try { Clear_Message(); m_arrMaster=await m_objController.List_Master_Async(m_strMasterType); Reset_Master(); } catch(Exception ex) { Error(ex); } }
    private async Task Save_Master_Async() { try { await m_objController.Save_Master_Async(m_strMasterType,m_objMaster); await Load_Lookups_Async(); await Load_Master_Async(); if(String.IsNullOrWhiteSpace(m_strError)) Success("Đã lưu danh mục."); } catch(Exception ex) { Error(ex); } }
    private void New_Master() { m_objMaster=new(); m_bMasterEditing=true; Clear_Message(); }
    private void Edit_Master(CWarehouseMaster item) { m_objMaster=new(){Auto_ID=item.Auto_ID,Code=item.Code,Name=item.Name,Related_ID=item.Related_ID,Related_ID_2=item.Related_ID_2,Login_Name=item.Login_Name,Ghi_Chu=item.Ghi_Chu}; m_bMasterEditing=true; Clear_Message(); }
    private void Reset_Master() { m_objMaster=new(); m_bMasterEditing=false; }
    private async Task Delete_Master_Async(long id) { try { await m_objController.Delete_Master_Async(m_strMasterType,id); await Load_Lookups_Async(); await Load_Master_Async(); if(String.IsNullOrWhiteSpace(m_strError)) Success("Đã xóa danh mục."); } catch(Exception ex) { Error(ex); } }
    private void New_Document() { m_objDocument=new(){Is_Receipt=Is_Receipt,Ngay_Chung_Tu=DateTime.Today}; m_objSelectedDocument=null; m_arrDetail.Clear(); m_objDetail=new(); m_bDocumentEditing=true; m_bDetailEditing=false; Clear_Message(); }
    private async Task Load_Documents_Async() { try { m_arrDocument=await m_objController.List_Documents_Async(Is_Receipt); } catch(Exception ex) { Error(ex); } }
    private void Cancel_Document() { m_bDocumentEditing=false; m_objDocument=new(){Is_Receipt=Is_Receipt,Ngay_Chung_Tu=DateTime.Today}; }
    private void Edit_Document(CWarehouseDocument item) { m_objDocument=new(){Auto_ID=item.Auto_ID,Is_Receipt=Is_Receipt,So_Phieu=item.So_Phieu,Kho_ID=item.Kho_ID,NCC_ID=item.NCC_ID,Ngay_Chung_Tu=item.Ngay_Chung_Tu,Ghi_Chu=item.Ghi_Chu}; m_objSelectedDocument=null; m_arrDetail.Clear(); m_bDocumentEditing=true; m_bDetailEditing=false; Clear_Message(); }
    private async Task Save_Document_Async() { try { m_objDocument.Is_Receipt=Is_Receipt; await m_objController.Save_Document_Async(m_objDocument); var documentId=m_objDocument.Auto_ID; Success("Đã lưu phiếu."); await Load_Documents_Async(); var saved=m_arrDocument.FirstOrDefault(x=>x.Auto_ID==documentId); if(saved is null) throw new InvalidOperationException("Không tìm thấy phiếu vừa lưu."); await Select_Document_Async(saved); } catch(Exception ex) { Error(ex); } }
    private async Task Delete_Document_Async(long id) { try { await m_objController.Delete_Document_Async(Is_Receipt,id); Success("Đã xóa phiếu."); Cancel_Document(); m_objSelectedDocument=null; m_arrDetail.Clear(); m_bDetailEditing=false; await Load_Documents_Async(); } catch(Exception ex) { Error(ex); } }
    private async Task Select_Document_Async(CWarehouseDocument item) { try { m_objSelectedDocument=item; m_objDocument=new(){Auto_ID=item.Auto_ID,Is_Receipt=Is_Receipt,So_Phieu=item.So_Phieu,Kho_ID=item.Kho_ID,NCC_ID=item.NCC_ID,Ngay_Chung_Tu=item.Ngay_Chung_Tu,Ghi_Chu=item.Ghi_Chu}; m_arrDetail=await m_objController.List_Document_Details_Async(Is_Receipt,item.Auto_ID); m_objDetail=new(){Document_ID=item.Auto_ID}; m_bDocumentEditing=false; m_bDetailEditing=false; } catch(Exception ex) { Error(ex); } }
    private void New_Detail() { if(m_objSelectedDocument is null) return; m_objDetail=new(){Document_ID=m_objSelectedDocument.Auto_ID}; m_bDetailEditing=true; Clear_Message(); }
    private async Task Save_Detail_Async() { try { if(m_objSelectedDocument==null) return; m_objDetail.Document_ID=m_objSelectedDocument.Auto_ID; await m_objController.Save_Document_Detail_Async(Is_Receipt,m_objDetail); Success("Đã lưu chi tiết."); await Select_Document_Async(m_objSelectedDocument); } catch(Exception ex) { Error(ex); } }
    private void Cancel_Detail() { if(m_objSelectedDocument is null) return; m_objDetail=new(){Document_ID=m_objSelectedDocument.Auto_ID}; m_bDetailEditing=false; }
    private void Edit_Detail(CWarehouseDocumentDetail item) { m_objDetail=new(){Auto_ID=item.Auto_ID,Document_ID=item.Document_ID,San_Pham_ID=item.San_Pham_ID,So_Luong=item.So_Luong,Don_Gia=item.Don_Gia}; m_bDetailEditing=true; Clear_Message(); }
    private async Task Delete_Detail_Async(long id) { try { if(m_objSelectedDocument==null) return; await m_objController.Delete_Document_Detail_Async(Is_Receipt,id); Success("Đã xóa chi tiết."); await Select_Document_Async(m_objSelectedDocument); } catch(Exception ex) { Error(ex); } }
    private async Task Load_Report_Async() { try { Clear_Message(); if(m_strReportType=="Inventory") m_arrInventoryReport=await m_objController.Inventory_Report_Async(m_dtmFrom,m_dtmTo); else m_arrDetailReport=await m_objController.Detail_Report_Async(m_strReportType=="Receipt",m_dtmFrom,m_dtmTo); } catch(Exception ex) { Error(ex); } }
    private Task Print_Async() => JS.InvokeVoidAsync("print").AsTask();
    private void Clear_Message(){m_strError="";m_strSuccess="";} private void Success(string text){m_strError="";m_strSuccess=text;} private void Error(Exception ex){m_strSuccess="";m_strError=ex.Message;}
}
